{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taarof.onlyarag.com/protocol/schemas/common.json",
  "title": "Taarof Remote Protocol Common Types",
  "type": "object",
  "$defs": {
    "ProtocolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "type": "integer", "const": 1 },
        "minor": { "type": "integer", "minimum": 0 }
      }
    },
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Uint64DecimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$",
      "description": "Unsigned 64-bit integer encoded as a base-10 string. Values greater than 18446744073709551615 are invalid."
    },
    "Base64String": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "UnixDeadlineMs": {
      "type": "integer",
      "minimum": 1,
      "description": "Unix epoch milliseconds. Gateway rejects signed messages whose deadline is more than 30 seconds old."
    },
    "Nonce": {
      "$ref": "#/$defs/Uuid",
      "description": "Client-generated one-use nonce scoped to the signed request or live WebSocket connection."
    },
    "Capability": {
      "type": "string",
      "enum": [
        "biometric_user_verification",
        "raw_pty",
        "legacy_snapshot",
        "runtime_mutation"
      ]
    },
    "Scope": {
      "type": "string",
      "enum": ["observe", "pane-control", "runtime-mutation"]
    },
    "RuntimeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "session_name"],
      "properties": {
        "instance_id": { "$ref": "#/$defs/Uuid" },
        "session_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "PaneRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_id", "tab_id", "pane_id"],
      "properties": {
        "runtime_id": { "$ref": "#/$defs/Uuid" },
        "tab_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "pane_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      }
    },
    "ConnectionCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch", "output_seq"],
      "properties": {
        "epoch": { "$ref": "#/$defs/Uuid" },
        "output_seq": { "$ref": "#/$defs/Uint64DecimalString" }
      }
    },
    "SignedRequestFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nonce", "deadline_ms"],
      "properties": {
        "nonce": { "$ref": "#/$defs/Nonce" },
        "deadline_ms": { "$ref": "#/$defs/UnixDeadlineMs" }
      }
    },
    "ErrorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "retry_after_ms": { "type": "integer", "minimum": 0, "maximum": 15000 }
      }
    },
    "ResourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_frame_bytes",
        "output_frame_bytes",
        "replay_window_bytes",
        "replay_window_ms",
        "attached_panes_per_device",
        "writable_panes_per_device",
        "paste_confirmation_bytes",
        "paste_reject_bytes",
        "metadata_requests_per_minute",
        "control_operations_per_second"
      ],
      "properties": {
        "control_frame_bytes": { "type": "integer", "const": 65536 },
        "output_frame_bytes": { "type": "integer", "const": 262144 },
        "replay_window_bytes": { "type": "integer", "const": 4194304 },
        "replay_window_ms": { "type": "integer", "const": 30000 },
        "attached_panes_per_device": { "type": "integer", "const": 4 },
        "writable_panes_per_device": { "type": "integer", "const": 1 },
        "paste_confirmation_bytes": { "type": "integer", "const": 1024 },
        "paste_reject_bytes": { "type": "integer", "const": 65536 },
        "metadata_requests_per_minute": { "type": "integer", "const": 120 },
        "control_operations_per_second": { "type": "integer", "const": 30 }
      }
    }
  }
}
