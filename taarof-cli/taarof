# ---------------------------------------------------------------------------
# Doctor: launch and runtime readiness diagnostics
# ---------------------------------------------------------------------------
#
# `taarof doctor` is strictly non-mutating: it never writes files, opens tabs,
# or sends state-changing socket commands. Each check is a small function that
# returns a record `{"name", "status", "detail", ...}` so the checks are
# unit-testable with patched env / mocked sockets. `run_doctor_checks` collects
# them; the overall result is "ok" unless any check has status "error".

DOCTOR_STATUSES = ("ok", "warn", "error", "skip")


def _check(name: str, status: str, detail: str, **extra: Any) -> dict[str, Any]:
    rec: dict[str, Any] = {"name": name, "status": status, "detail": detail}
    rec.update(extra)
    return rec


def _pid_alive(pid: int) -> bool:
    """Best-effort liveness probe for a pid owned by (or visible to) us."""
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        # Exists but owned by another user.
        return True
    except OSError:
        # Fall back to /proc.
        return Path(f"/proc/{pid}").exists()


def _pid_exe(pid: int) -> str | None:
    """Best-effort executable path for a pid via /proc/<pid>/exe."""
    try:
        return os.readlink(f"/proc/{pid}/exe")
    except OSError:
        return None


def _load_config() -> tuple[dict[str, Any] | None, str | None]:
    """Return (parsed config, reason-if-unavailable). Never raises."""
    cfg_path = Path.home() / ".config" / "taarof" / "config.toml"
    if not cfg_path.exists():
        return {}, None  # no config == all defaults
    if tomllib is None:
        return None, "Python 3.11+ (tomllib) required to parse config.toml"
    try:
        return tomllib.loads(cfg_path.read_text()), None
    except (OSError, ValueError) as err:
        return None, f"could not parse {cfg_path}: {err}"


def _http_base_from_config(cfg: dict[str, Any] | None) -> str:
    """Prefer TAAROF_HTTP, else derive from config [http].port, else default."""
    override = os.environ.get("TAAROF_HTTP")
    if override:
        return override.rstrip("/")
    port = 7800
    if isinstance(cfg, dict):
        http = cfg.get("http")
        if isinstance(http, dict) and isinstance(http.get("port"), int):
            port = http["port"]
    return f"http://127.0.0.1:{port}"


def _http_enabled(cfg: dict[str, Any] | None) -> bool:
    if not isinstance(cfg, dict):
        return False
    http = cfg.get("http")
    return bool(isinstance(http, dict) and http.get("enabled"))


def _history_enabled(cfg: dict[str, Any] | None) -> bool:
    if not isinstance(cfg, dict):
        return False
    history = cfg.get("history")
    return bool(isinstance(history, dict) and history.get("enabled"))


def check_app_registry(session: str | None) -> tuple[dict[str, Any], dict[str, Any]]:
    """Check the app registry file. Returns (record, facts) where facts feed
    later checks (pid, socket_path, exe, alive)."""
    facts: dict[str, Any] = {"pid": None, "socket_path": None, "alive": False}
    override = os.environ.get("TAAROF_SOCK")
    reg = _registry_path(session)
    facts["registry_path"] = str(reg)

    if not reg.exists():
        detail = (
            f"registry not found at {reg} — the taarof app does not appear to be "
            f"running (missing app)."
        )
        if override:
            detail += f" TAAROF_SOCK={override} is set and will be used for the socket check."
            facts["socket_path"] = override
        return _check("app.registry", "error", detail, registry_path=str(reg)), facts

    try:
        data = json.loads(reg.read_text())
    except (OSError, ValueError) as err:
        return _check("app.registry", "error",
                      f"registry {reg} exists but does not parse: {err}",
                      registry_path=str(reg)), facts
    if not isinstance(data, dict):
        return _check("app.registry", "error",
                      f"registry {reg} is not a JSON object",
                      registry_path=str(reg)), facts

    pid = data.get("pid")
    socket_path = data.get("socket_path")
    facts["pid"] = pid if isinstance(pid, int) else None
    facts["socket_path"] = override or (socket_path if isinstance(socket_path, str) else None)

    if not isinstance(pid, int):
        return _check("app.registry", "warn",
                      f"registry {reg} present but missing/invalid pid",
                      registry_path=str(reg), socket_path=facts["socket_path"]), facts

    alive = _pid_alive(pid)
    facts["alive"] = alive
    exe = _pid_exe(pid) if alive else None
    if exe:
        facts["exe"] = exe

    if not alive:
        return _check(
            "app.registry", "error",
            f"registry points at pid {pid} which is not alive — stale registry "
            f"(the app died without cleaning up). Restart taarof.",
            registry_path=str(reg), pid=pid, alive=False,
            socket_path=facts["socket_path"],
        ), facts

    detail = f"app running as pid {pid}"
    if exe:
        detail += f" ({exe})"
    return _check("app.registry", "ok", detail,
                  registry_path=str(reg), pid=pid, alive=True, exe=exe,
                  socket_path=facts["socket_path"]), facts


def check_socket(facts: dict[str, Any], session: str | None,
                 timeout: float = 2.0) -> dict[str, Any]:
    """Round-trip a cheap read (`list-tabs`) over the Unix socket."""
    path = facts.get("socket_path")
    if not path:
        return _check("socket.reachability", "error",
                      "no socket_path known (registry missing or malformed); "
                      "cannot probe the control socket.")
    if not Path(path).exists():
        stale = " — registry is stale (app died)" if facts.get("pid") and not facts.get("alive") \
            else ""
        return _check("socket.reachability", "error",
                      f"socket file missing at {path}{stale}.", socket_path=path)

    import time
    start = time.monotonic()
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    try:
        try:
            sock.connect(path)
        except ConnectionRefusedError:
            return _check("socket.reachability", "error",
                          f"connection refused at {path} — stale registry (app died "
                          f"but left its socket file). Restart taarof.",
                          socket_path=path)
        except (FileNotFoundError, OSError) as err:
            return _check("socket.reachability", "error",
                          f"could not connect to {path}: {err}", socket_path=path)

        line = (json.dumps({"action": "list-tabs"}, separators=(",", ":")) + "\n").encode()
        try:
            sock.sendall(line)
            try:
                sock.shutdown(socket.SHUT_WR)
            except OSError:
                pass
            chunks: list[bytes] = []
            while True:
                buf = sock.recv(65536)
                if not buf:
                    break
                chunks.append(buf)
        except socket.timeout:
            return _check("socket.reachability", "error",
                          f"connected to {path} but got no response before {timeout}s — "
                          f"closed/failed socket queue (app stuck). Restart taarof.",
                          socket_path=path)
        raw = b"".join(chunks).decode(errors="replace").strip()
        if not raw:
            return _check("socket.reachability", "error",
                          f"connected to {path} but the server closed with no response — "
                          f"closed/failed socket queue.", socket_path=path)
        latency_ms = round((time.monotonic() - start) * 1000, 1)
        try:
            resp = json.loads(raw.splitlines()[-1])
            ok = isinstance(resp, dict) and resp.get("ok") is not False
        except ValueError:
            ok = False
        if not ok:
            return _check("socket.reachability", "warn",
                          f"socket responded at {path} but the reply was not a success "
                          f"envelope (latency {latency_ms}ms).",
                          socket_path=path, latency_ms=latency_ms)
        return _check("socket.reachability", "ok",
                      f"list-tabs round-trip ok ({latency_ms}ms).",
                      socket_path=path, latency_ms=latency_ms)
    finally:
        sock.close()


def check_update(facts: dict[str, Any], session: str | None) -> dict[str, Any]:
    """Read the app's cached executable identity without doing local file IO."""
    if not facts.get("alive") or not facts.get("socket_path"):
        return _check(
            "app.update", "skip",
            "app or control socket unavailable; update status was not checked.",
        )
    try:
        response = socket_send({"action": "query-state"}, session=session, timeout=2.0)
    except (OSError, ValueError, KeyError, TypeError, SystemExit) as err:
        return _check(
            "app.update", "skip",
            f"query-state unavailable; update status was not checked ({type(err).__name__}).",
        )

    data = response.get("data") if isinstance(response, dict) else None
    update = data.get("update") if isinstance(data, dict) else None
    if not isinstance(update, dict):
        return _check(
            "app.update", "skip",
            "query-state did not include update status (older app or check pending).",
        )

    raw_state = update.get("state")
    state = (
        raw_state
        if isinstance(raw_state, str)
        and raw_state in {"current", "update_pending", "unknown"}
        else "unknown"
    )
    raw_reason = update.get("reason")
    reason = raw_reason if isinstance(raw_reason, str) else None
    running = update.get("running") if isinstance(update.get("running"), dict) else {}
    installed = update.get("installed") if isinstance(update.get("installed"), dict) else {}
    running_sha256 = running.get("sha256") if isinstance(running.get("sha256"), str) else None
    installed_sha256 = (
        installed.get("sha256") if isinstance(installed.get("sha256"), str) else None
    )
    installed_path = installed.get("path") if isinstance(installed.get("path"), str) else None
    checked_at_unix_ms = update.get("checked_at_unix_ms")
    if (
        not isinstance(checked_at_unix_ms, int)
        or isinstance(checked_at_unix_ms, bool)
        or checked_at_unix_ms < 0
    ):
        checked_at_unix_ms = None

    status = {"current": "ok", "update_pending": "warn", "unknown": "skip"}[state]
    short_running = running_sha256[:12] if running_sha256 else "unavailable"
    short_installed = installed_sha256[:12] if installed_sha256 else "unavailable"
    detail = (
        f"state={state} running={short_running} "
        f"installed={short_installed} path={installed_path or 'unavailable'} "
        f"reason={reason or 'none'}; restart is operator-controlled."
    )
    return _check(
        "app.update", status, detail,
        state=state,
        reason=reason,
        running_sha256=running_sha256,
        installed_sha256=installed_sha256,
        installed_path=installed_path,
        checked_at_unix_ms=checked_at_unix_ms,
    )


def check_runtime_probe(facts: dict[str, Any], session: str | None) -> dict[str, Any]:
    """Report cached process/port truth without initiating a new runtime scan."""
    if not facts.get("alive") or not facts.get("socket_path"):
        return _check(
            "runtime.probe", "skip",
            "app or control socket unavailable; runtime probe truth was not checked.",
        )
    try:
        response = socket_send({"action": "query-state"}, session=session, timeout=2.0)
    except (OSError, ValueError, KeyError, TypeError, SystemExit) as err:
        return _check(
            "runtime.probe", "skip",
            f"query-state unavailable; runtime probe truth was not checked ({type(err).__name__}).",
        )

    data = response.get("data") if isinstance(response, dict) else None
    probe = data.get("runtime_probe") if isinstance(data, dict) else None
    if not isinstance(probe, dict):
        return _check(
            "runtime.probe", "skip",
            "query-state did not include runtime probe truth (older app).",
        )

    raw_state = probe.get("state")
    state = raw_state if raw_state in {
        "ok", "absent", "partial", "stale", "failed", "unknown"
    } else "unknown"
    component_details = []
    fields: dict[str, Any] = {"state": state}
    for name in ("process", "ports"):
        component = probe.get(name)
        component = component if isinstance(component, dict) else {}
        raw_component_state = component.get("state")
        component_state = raw_component_state if raw_component_state in {
            "ok", "stale", "unknown", "error"
        } else "unknown"
        age_ms = component.get("age_ms")
        if not isinstance(age_ms, int) or isinstance(age_ms, bool) or age_ms < 0:
            age_ms = None
        raw_reason = component.get("error")
        reason = raw_reason if isinstance(raw_reason, str) else None
        if reason:
            reason = " ".join(reason.split())[:160]
        detail = f"{name}={component_state}"
        if age_ms is not None:
            detail += f" age={age_ms}ms"
        if reason:
            detail += f" reason={reason}"
        component_details.append(detail)
        fields[f"{name}_state"] = component_state
        fields[f"{name}_age_ms"] = age_ms
        fields[f"{name}_error"] = reason

    status = {
        "ok": "ok",
        "absent": "skip",
        "partial": "warn",
        "stale": "warn",
        "failed": "error",
        "unknown": "warn",
    }[state]
    if state == "absent":
        detail = "runtime probe absent: no live process roots to inspect."
    else:
        detail = f"runtime probe {state}: {'; '.join(component_details)}."
    return _check("runtime.probe", status, detail, **fields)


def check_runtime_dir() -> dict[str, Any]:
    """XDG_RUNTIME_DIR must exist, be owned by us, and be mode 0700."""
    rd = _runtime_dir()
    if not rd.exists():
        return _check("runtime.permissions", "warn",
                      f"runtime dir {rd} does not exist.", path=str(rd))
    try:
        st = rd.stat()
    except OSError as err:
        return _check("runtime.permissions", "warn",
                      f"could not stat {rd}: {err}", path=str(rd))
    uid = os.getuid()
    mode = st.st_mode & 0o777
    if st.st_uid != uid:
        return _check("runtime.permissions", "warn",
                      f"{rd} is owned by uid {st.st_uid}, not you ({uid}) — trust "
                      f"boundary violation for the control socket.",
                      path=str(rd), owner_uid=st.st_uid, mode=oct(mode))
    if mode != 0o700:
        return _check("runtime.permissions", "warn",
                      f"{rd} is mode {oct(mode)}, expected 0o700 — other users may "
                      f"reach the control socket. Run: chmod 700 {rd}",
                      path=str(rd), mode=oct(mode))
    return _check("runtime.permissions", "ok",
                  f"{rd} owned by you and mode 0700.", path=str(rd), mode=oct(mode))


def check_http(facts: dict[str, Any], cfg: dict[str, Any] | None,
               cfg_reason: str | None, session: str | None,
               timeout: float = 2.0) -> list[dict[str, Any]]:
    """Return three records: health reachability, token discovery, authed state."""
    base = _http_base_from_config(cfg)

    if cfg_reason is not None:
        # Could not read config; report skip but still allow env override probing.
        if not os.environ.get("TAAROF_HTTP"):
            note = _check("http.health", "skip",
                          f"HTTP config unreadable ({cfg_reason}); set TAAROF_HTTP to probe.",
                          base=base)
            return [note,
                    _check("http.token", "skip", "skipped (HTTP config unreadable)."),
                    _check("http.state", "skip", "skipped (HTTP config unreadable).")]
    elif not _http_enabled(cfg) and not os.environ.get("TAAROF_HTTP"):
        hint = "HTTP API disabled. Enable with [http]\\nenabled = true in config.toml."
        return [_check("http.health", "skip", hint, base=base),
                _check("http.token", "skip", "skipped (HTTP disabled)."),
                _check("http.state", "skip", "skipped (HTTP disabled).")]

    records: list[dict[str, Any]] = []

    # (a) /health reachability
    health_ok = False
    try:
        req = urllib.request.Request(base + "/health")
        with urllib.request.urlopen(req, timeout=timeout) as resp:  # noqa: S310
            resp.read()
        health_ok = True
        records.append(_check("http.health", "ok", f"GET {base}/health reachable.", base=base))
    except urllib.error.HTTPError as err:
        # Reachable but non-2xx still means the server is up.
        health_ok = True
        records.append(_check("http.health", "warn",
                              f"GET {base}/health returned HTTP {err.code}.", base=base))
    except (urllib.error.URLError, OSError) as err:
        records.append(_check("http.health", "error",
                              f"GET {base}/health failed: {err}. Is HTTP enabled and the "
                              f"app running?", base=base))

    # (b) token discovery
    token = os.environ.get("TAAROF_HTTP_TOKEN")
    token_source = "env" if token else None
    token_path_str = None
    if not token:
        pid = facts.get("pid")
        if isinstance(pid, int):
            tp = _runtime_dir() / f"taarof-http-{pid}.token"
            token_path_str = str(tp)
            try:
                token = tp.read_text(encoding="utf-8").strip() or None
                if token:
                    token_source = str(tp)
            except OSError:
                token = None
    if token:
        records.append(_check("http.token", "ok",
                              f"bearer token found ({token_source}).",
                              token_source=token_source))
    else:
        where = token_path_str or "runtime dir (pid unknown)"
        records.append(_check("http.token", "error",
                              f"no HTTP bearer token found at {where} — missing token; "
                              f"cannot authenticate. Is the app running with HTTP enabled?"))

    # (c) authenticated GET /api/v1/state
    if not health_ok:
        records.append(_check("http.state", "skip",
                              "skipped (/health not reachable)."))
    elif not token:
        records.append(_check("http.state", "skip",
                              "skipped (no bearer token)."))
    else:
        try:
            req = urllib.request.Request(
                base + "/api/v1/state", headers={"Authorization": f"Bearer {token}"})
            with urllib.request.urlopen(req, timeout=timeout) as resp:  # noqa: S310
                json.loads(resp.read().decode())
            records.append(_check("http.state", "ok",
                                  f"authenticated GET {base}/api/v1/state ok.", base=base))
        except urllib.error.HTTPError as err:
            records.append(_check("http.state", "error",
                                  f"GET {base}/api/v1/state -> HTTP {err.code} "
                                  f"(token rejected?).", base=base))
        except (urllib.error.URLError, OSError, ValueError) as err:
            records.append(_check("http.state", "error",
                                  f"GET {base}/api/v1/state failed: {err}", base=base))
    return records


def check_history(cfg: dict[str, Any] | None, cfg_reason: str | None,
                  session: str | None) -> dict[str, Any]:
    if cfg_reason is not None:
        return _check("history", "error", f"history config unreadable ({cfg_reason}).")
    configured_enabled = _history_enabled(cfg)
    try:
        response = socket_send({"action": "query-state"}, session=session)
    except (OSError, ValueError, SystemExit) as err:
        if not configured_enabled:
            return _check("history", "skip",
                          "history disabled. Enable with [history] enabled = true.")
        return _check("history", "error", f"could not query history status: {err}")
    data = response.get("data") if isinstance(response, dict) else None
    history = data.get("history") if isinstance(data, dict) else None
    if not isinstance(history, dict):
        if not configured_enabled:
            return _check("history", "skip",
                          "history disabled. Enable with [history] enabled = true.")
        return _check("history", "error",
                      "running app does not report history status; restart an updated build.")
    state = history.get("state") or "unknown"
    available = bool(history.get("available"))
    lag_ms = history.get("lag_ms", 0)
    queue_depth = history.get("queue_depth", 0)
    schema = history.get("schema_version", 0)
    reason = history.get("reason")
    durable = history.get("last_durable_seq")
    if not isinstance(durable, dict):
        durable = {"event": 0, "work": 0, "id": 0}
    durable = {
        "event": durable.get("event", 0),
        "work": durable.get("work", 0),
        "id": durable.get("id", 0),
    }
    dropped = history.get("dropped", 0)
    storage = history.get("storage")
    if not isinstance(storage, dict):
        storage = {}
    storage = {
        "main_bytes": storage.get("main_bytes", 0),
        "wal_bytes": storage.get("wal_bytes", 0),
        "soft_max_bytes": storage.get("soft_max_bytes", 0),
        "record_count": storage.get("record_count", 0),
        "oldest_record_ts_unix_ms": storage.get("oldest_record_ts_unix_ms"),
        "newest_record_ts_unix_ms": storage.get("newest_record_ts_unix_ms"),
    }
    maintenance = history.get("maintenance")
    if not isinstance(maintenance, dict):
        maintenance = {}
    maintenance = {
        "last_result": maintenance.get("last_result", "never"),
        "last_run_at_unix_ms": maintenance.get("last_run_at_unix_ms"),
        "rows_removed_last": maintenance.get("rows_removed_last", 0),
        "rows_removed_total": maintenance.get("rows_removed_total", 0),
        "consecutive_failures": maintenance.get("consecutive_failures", 0),
        "last_error": maintenance.get("last_error"),
    }
    detail = (
        f"schema {schema}, DB/WAL {storage['main_bytes']}/{storage['wal_bytes']} bytes, "
        f"records {storage['record_count']} "
        f"(oldest/newest {storage['oldest_record_ts_unix_ms']}/"
        f"{storage['newest_record_ts_unix_ms']}), maintenance "
        f"{maintenance['last_result']} removed {maintenance['rows_removed_last']} "
        f"(total {maintenance['rows_removed_total']}), queue {queue_depth}, "
        f"writer lag {lag_ms}ms, durable "
        f"event/work/id {durable['event']}/{durable['work']}/{durable['id']}, "
        f"dropped {dropped}"
    )
    fields = {
        "available": available, "schema_version": schema, "lag_ms": lag_ms,
        "queue_depth": queue_depth, "last_durable_seq": durable,
        "dropped": dropped, "storage": storage, "maintenance": maintenance,
    }
    total_bytes = storage["main_bytes"] + storage["wal_bytes"]
    over_soft_cap = (
        storage["soft_max_bytes"] > 0
        and total_bytes > storage["soft_max_bytes"]
    )
    if state == "misconfigured":
        return _check("history", "error",
                      f"history {state}: {reason or 'invalid configuration'} ({detail}).",
                      **fields)
    if not configured_enabled and state == "disabled":
        return _check("history", "skip",
                      "history disabled. Enable with [history] enabled = true.",
                      **fields)
    if not available or state == "unavailable":
        return _check("history", "error",
                      f"history {state}: {reason or 'unavailable'} ({detail}).",
                      **fields)
    if maintenance["consecutive_failures"] > 0 or over_soft_cap or state != "ok":
        if maintenance["consecutive_failures"] > 0:
            warning = maintenance["last_error"] or "history maintenance is failing"
        elif over_soft_cap:
            warning = (
                f"storage remains over the {storage['soft_max_bytes']} byte soft cap"
            )
        else:
            warning = reason or f"history state is {state}"
        return _check("history", "warn",
                      f"history needs attention: {warning} ({detail}).",
                      **fields)
    if available and state == "ok":
        return _check("history", "ok",
                      f"history available ({detail}).",
                      **fields)
    return _check("history", "error",
                  f"history {state}: {reason or 'unavailable'} ({detail}).",
                  **fields)


def check_tmux() -> list[dict[str, Any]]:
    """tmux binary presence, local server liveness, nested-tmux warning."""
    import shutil
    records: list[dict[str, Any]] = []
    tmux = shutil.which("tmux")
    if not tmux:
        records.append(_check("tmux.binary", "warn",
                              "tmux not found on PATH — tmux-backed tabs unavailable."))
        return records
    records.append(_check("tmux.binary", "ok", f"tmux found at {tmux}."))

    try:
        proc = subprocess.run([tmux, "list-sessions"],
                              capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as err:
        records.append(_check("tmux.server", "warn",
                              f"could not run tmux list-sessions: {err}"))
    else:
        combined = (proc.stdout + proc.stderr).lower()
        no_server_markers = (
            "no server running",
            "no sessions",
            "error connecting",
            "failed to connect",
            "no such file or directory",
        )
        if proc.returncode == 0:
            n = len([ln for ln in proc.stdout.splitlines() if ln.strip()])
            records.append(_check("tmux.server", "ok",
                                  f"local tmux server running ({n} session(s))."))
        elif any(m in combined for m in no_server_markers):
            records.append(_check("tmux.server", "skip",
                                  "no local tmux server running (this is normal until a "
                                  "tmux tab is created)."))
        else:
            records.append(_check("tmux.server", "warn",
                                  f"tmux list-sessions exited {proc.returncode}: "
                                  f"{proc.stderr.strip() or proc.stdout.strip()}"))

    if os.environ.get("TMUX"):
        records.append(_check("tmux.nested", "warn",
                              "$TMUX is set — you are inside a tmux session; taarof's own "
                              "tmux tabs would nest. Consider running taarof outside tmux."))
    return records


def check_hosts(cfg: dict[str, Any] | None, cfg_reason: str | None,
                probe: bool) -> list[dict[str, Any]]:
    """Report configured [hosts.<name>] entries; optionally ssh-probe them."""
    if cfg_reason is not None:
        return [_check("hosts.config", "skip",
                       f"host config unreadable ({cfg_reason}).")]
    hosts = (cfg or {}).get("hosts")
    if not isinstance(hosts, dict) or not hosts:
        return [_check("hosts.config", "skip",
                       "no [hosts.*] configured in config.toml.")]

    records: list[dict[str, Any]] = []
    for name in sorted(hosts):
        entry = hosts[name]
        target = entry.get("address") if isinstance(entry, dict) else None
        cname = f"hosts.{name}"
        if not target:
            records.append(_check(cname, "skip",
                                  f"host '{name}' has no address (local-only entry)."))
            continue
        if not probe:
            records.append(_check(cname, "skip",
                                  f"ssh target {target} not probed (use --probe-hosts).",
                                  target=target))
            continue
        records.append(_probe_host(cname, target))
    return records


def _probe_host(cname: str, target: str) -> dict[str, Any]:
    """Attempt a non-interactive `ssh -o BatchMode=yes <target> true`.

    BatchMode=yes fails fast instead of hanging on a password prompt, so a
    permission-denied result specifically flags remote SSH prompt risk.
    """
    try:
        proc = subprocess.run(
            ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3",
             "-o", "StrictHostKeyChecking=accept-new", target, "true"],
            capture_output=True, text=True, timeout=10,
        )
    except subprocess.TimeoutExpired:
        return _check(cname, "error",
                      f"ssh {target} timed out (host unreachable or hanging).",
                      target=target)
    except OSError as err:
        return _check(cname, "warn", f"could not run ssh for {target}: {err}", target=target)
    if proc.returncode == 0:
        return _check(cname, "ok", f"ssh {target} reachable (key auth).", target=target)
    err = proc.stderr.lower()
    if "permission denied" in err or "password" in err or "publickey" in err:
        return _check(cname, "warn",
                      f"ssh {target} refused non-interactive auth — would prompt for a "
                      f"password interactively (remote SSH prompt risk). Set up key auth.",
                      target=target)
    return _check(cname, "warn",
                  f"ssh {target} failed (exit {proc.returncode}): "
                  f"{proc.stderr.strip() or 'unknown error'}",
                  target=target)


def run_doctor_checks(session: str | None, *, probe_hosts: bool = False) -> dict[str, Any]:
    """Collect all doctor checks into {"ok", "checks"}. Never raises."""
    checks: list[dict[str, Any]] = []

    reg_record, facts = check_app_registry(session)
    checks.append(reg_record)
    checks.append(check_socket(facts, session))
    checks.append(check_update(facts, session))
    # Separate from `app.update` on purpose: same-binary is not same-source.
    checks.append(check_identity(facts, session))
    checks.append(check_runtime_probe(facts, session))
    checks.append(check_runtime_dir())

    cfg, cfg_reason = _load_config()
    checks.extend(check_http(facts, cfg, cfg_reason, session))
    checks.append(check_history(cfg, cfg_reason, session))
    checks.extend(check_tmux())
    checks.extend(check_hosts(cfg, cfg_reason, probe_hosts))

    overall_ok = not any(c.get("status") == "error" for c in checks)
    return {"ok": overall_ok, "checks": checks}


def cmd_doctor(args: argparse.Namespace) -> Any:
    return run_doctor_checks(args.session, probe_hosts=args.probe_hosts)


def render_doctor(result: dict[str, Any]) -> str:
    """Human table of doctor checks."""
    checks = result.get("checks") or []
    rows = [[c.get("status", ""), c.get("name", ""), c.get("detail", "")] for c in checks]
    table = _render_table(["status", "check", "detail"], rows)
    overall = "ok" if result.get("ok") else "PROBLEMS FOUND"
    return f"{table}\n\noverall: {overall}"


