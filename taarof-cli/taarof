def _send_keys_payload(args: argparse.Namespace) -> str:
    if args.keys_file is not None:
        try:
            keys = Path(args.keys_file).read_text(encoding="utf-8")
        except OSError as err:
            raise SystemExit(f"failed to read --keys-file {args.keys_file}: {err}")
    elif args.stdin:
        keys = sys.stdin.read()
    else:
