#!/usr/bin/env python3
"""Thin client for the taarof control surface.

Reads: HTTP GET on 127.0.0.1:7800 (configurable).
Writes: JSON messages over the Unix socket discovered via taarof-current.json.

Run with --help on any subcommand. Repo docs cover install and examples.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import shlex
import socket
import subprocess
import sys
import urllib.request
from pathlib import Path
from typing import Any

try:
    import tomllib  # Python 3.11+
except ModuleNotFoundError:  # pragma: no cover
    tomllib = None  # type: ignore[assignment]


def _runtime_dir() -> Path:
    xdg = os.environ.get("XDG_RUNTIME_DIR")
    if xdg:
        return Path(xdg)
    return Path(f"/run/user/{os.getuid()}")


def _session_storage_key(session: str) -> str:
    session = session.strip()
    if not session:
        return "default"
    normalized: list[str] = []
    last_dash = False
    for char in session:
        if char.isascii() and (char.isalnum() or char in "-_"):
            normalized.append(char)
            last_dash = False
        elif not last_dash:
            normalized.append("-")
            last_dash = True
    slug = "".join(normalized).strip("-")
    if not slug:
        slug = session.encode().hex()
    slug = slug[:48]
    digest = hashlib.sha256(session.encode()).hexdigest()[:32]
    return f"{slug}-{digest}"


def _registry_path(session: str | None) -> Path:
    session = session.strip() if session else None
    name = (
        "taarof-current.json"
        if not session
        else f"taarof-current-{_session_storage_key(session)}.json"
    )
    return _runtime_dir() / name


def _registry_data(session: str | None) -> dict[str, Any]:
    reg = _registry_path(session)
    if not reg.exists():
        raise SystemExit(
            f"taarof registry not found at {reg}. Is the app running? "
            f"Set TAAROF_SOCK to override."
        )
    try:
        data = json.loads(reg.read_text())
    except json.JSONDecodeError as err:
        raise SystemExit(f"invalid registry {reg}: {err}")
    if not isinstance(data, dict):
        raise SystemExit(f"invalid registry {reg}: expected JSON object")
    return data


# ---------------------------------------------------------------------------
# Runtime identity
#
# (No task-tracker id in this file on purpose: the public-export scrubber in
# scripts/bootstrap-taarof.sh only rewrites files with a known suffix, and this
# CLI is extensionless, so a task ref here would leak verbatim.)
#
# Five surfaces can answer "what is running": the registry file, query-state,
# the HTTP runtime-identity route, `--version`, and Doctor. They agree because
# they all pass the app's identity block through `normalize_identity` rather
# than each picking the fields it happens to care about.
#
# The invariant this code exists to hold: `source_state` is only ever "matches"
# when the running binary recorded the revision it was built from. Two binaries
# hashing the same proves they are the same binary — never that either was
# built from the source in front of you. Missing provenance is "unknown".
# ---------------------------------------------------------------------------

#: Keep in step with taarof-app/Cargo.toml `version`; a contract test enforces it.
CLI_VERSION = "0.1.0"
IDENTITY_SCHEMA = "taarof.identity.v1"
VERSION_SCHEMA = "taarof.version.v1"

_SOURCE_STATES = ("matches", "differs", "unknown")
_BINARY_STATES = ("current", "update_pending", "unknown")


def _opt_str(value: Any) -> str | None:
    return value if isinstance(value, str) and value.strip() else None


def _opt_bool(value: Any) -> bool | None:
    return value if isinstance(value, bool) else None


def _valid_sha256(value: Any) -> str | None:
    value = _opt_str(value)
    if value is None or len(value) != 64:
        return None
    return value if all(char in "0123456789abcdefABCDEF" for char in value) else None


def _sub(mapping: Any, key: str) -> dict[str, Any]:
    if not isinstance(mapping, dict):
        return {}
    value = mapping.get(key)
    return value if isinstance(value, dict) else {}


def normalize_identity(raw: Any) -> dict[str, Any]:
    """Coerce any surface's identity block into the one shape the CLI reports.

    Unknown, missing or malformed input yields an all-unknown identity. A
    reported `source_state` of "matches" is downgraded to "unknown" unless the
    build revision that would justify it is actually present — so a stale or
    over-eager producer cannot talk the CLI into vouching for freshness.
    """
    if not isinstance(raw, dict):
        raw = {}

    build = _sub(raw, "build")
    source_revision = _opt_str(build.get("source_revision"))
    source_dirty = _opt_bool(build.get("source_dirty"))
    source = _sub(raw, "source")
    checkout_revision = _opt_str(source.get("revision"))
    checkout_dirty = _opt_bool(source.get("dirty"))

    source_state = raw.get("source_state")
    if source_state not in _SOURCE_STATES:
        source_state = "unknown"
    if source_state == "matches" and not (
        source_revision is not None
        and source_revision == checkout_revision
        and source_dirty is False
        and checkout_dirty is False
    ):
        source_state = "unknown"

    binary_state = raw.get("binary_state")
    running = _sub(raw, "running")
    installed = _sub(raw, "installed")
    running_sha256 = _valid_sha256(running.get("sha256"))
    installed_sha256 = _valid_sha256(installed.get("sha256"))
    if running_sha256 is not None and installed_sha256 is not None:
        running_matches_installed: bool | None = running_sha256 == installed_sha256
    else:
        running_matches_installed = None
    if binary_state not in _BINARY_STATES or (
        binary_state == "current" and running_matches_installed is not True
    ):
        binary_state = "unknown"
    provenance = _sub(raw, "installed_provenance")

    return {
        "schema": IDENTITY_SCHEMA,
        "app_version": _opt_str(raw.get("app_version")),
        "source_revision": source_revision,
        "source_describe": _opt_str(build.get("source_describe")),
        "source_dirty": source_dirty,
        "checkout_revision": checkout_revision,
        "checkout_dirty": checkout_dirty,
        "installed_source_revision": _opt_str(provenance.get("source_revision")),
        "running_path": _opt_str(running.get("path")),
        "installed_path": _opt_str(installed.get("path")),
        "running_sha256": running_sha256,
        "installed_sha256": installed_sha256,
        "running_matches_installed": running_matches_installed,
        "source_state": source_state,
        "binary_state": binary_state,
    }


def identity_from_registry(data: Any) -> dict[str, Any]:
    """Identity straight out of taarof-current.json — no round-trip needed."""
    return normalize_identity(_sub(data, "identity") or None)


def identity_from_query_state(payload: Any) -> dict[str, Any]:
    """Identity from a `query-state` reply (envelope or bare data)."""
    if isinstance(payload, dict) and "data" in payload:
        payload = payload.get("data")
    return normalize_identity(_sub(payload, "identity") or None)


def identity_from_runtime_identity(payload: Any) -> dict[str, Any]:
    """Identity from GET /api/v1/runtime-identity."""
    if isinstance(payload, dict) and "data" in payload:
        payload = payload.get("data")
    return normalize_identity(_sub(payload, "identity") or None)


def describe_identity(identity: dict[str, Any]) -> str:
    """One human line that never implies more confidence than we have."""
    source = {
        "matches": "matches this checkout",
        "differs": "DIFFERS from this checkout",
        "unknown": "unknown (not provable)",
    }[identity["source_state"]]
    running_installed = {
        True: "yes",
        False: "no (an update is installed)",
        None: "unknown",
    }[identity["running_matches_installed"]]
    return (
        f"version={identity['app_version'] or 'unknown'} "
        f"built-from={identity['source_revision'][:12] if identity['source_revision'] else 'unknown'} "
        f"source={source} running-is-installed={running_installed} "
        f"binary={identity['binary_state']}"
    )


def build_version_report(session: str | None) -> dict[str, Any]:
    """Assemble `taarof --version`.

    Prefers the registry because it needs no running socket, then falls back to
    query-state for an app too old to publish identity into the registry. If
    neither answers, the identity is unknown rather than absent — a caller must
    still get a well-formed verdict to compare against other surfaces.
    """
    report: dict[str, Any] = {
        "schema": VERSION_SCHEMA,
        "cli_version": CLI_VERSION,
        "identity_source": "unavailable",
        "identity": normalize_identity(None),
        "error": None,
    }

    registry: dict[str, Any] | None = None
    try:
        registry = _registry_data(session)
    except SystemExit as err:
        report["error"] = str(err)

    if registry is not None and isinstance(registry.get("identity"), dict):
        report["identity"] = identity_from_registry(registry)
        report["identity_source"] = "registry"
        return report

    try:
        response = socket_send({"action": "query-state"}, session=session, timeout=2.0)
    except (OSError, ValueError, KeyError, TypeError, SystemExit) as err:
        if report["error"] is None:
            report["error"] = f"query-state unavailable ({type(err).__name__})"
        return report

    identity = identity_from_query_state(response)
    if identity != normalize_identity(None):
        report["identity"] = identity
        report["identity_source"] = "query-state"
        report["error"] = None
    elif report["error"] is None:
        report["error"] = "the running app does not publish runtime identity"
    return report


def cmd_version(args: argparse.Namespace) -> Any:
    return build_version_report(getattr(args, "session", None))


def render_version(result: Any) -> str | None:
    if not isinstance(result, dict) or "identity" not in result:
        return None
    identity = result["identity"]
    rows = [
        ["cli", CLI_VERSION],
        ["app", identity["app_version"] or "unknown"],
        ["built from", identity["source_describe"] or identity["source_revision"] or "unknown"],
        ["checkout now", identity["checkout_revision"] or "unknown"],
        ["source match", identity["source_state"]],
        ["installed from", identity["installed_source_revision"] or "unknown"],
        ["running path", identity["running_path"] or "unknown"],
        ["installed path", identity["installed_path"] or "unknown"],
        ["running is installed", {True: "yes", False: "no", None: "unknown"}[
            identity["running_matches_installed"]]],
        ["binary state", identity["binary_state"]],
        ["identity from", result.get("identity_source", "unavailable")],
    ]
    table = _render_table(["field", "value"], rows)
    if result.get("error"):
        return f"{table}\n\nnote: {result['error']}"
    return table


def check_identity(facts: dict[str, Any], session: str | None) -> dict[str, Any]:
    """Doctor's source-provenance check.

    Deliberately distinct from `app.update`: that one asks whether the running
    binary is the installed binary, this one asks whether it was built from this
    source. Only a proved match is `ok`; an unprovable one is `skip`, never a
    green tick.
    """
    if not facts.get("alive") or not facts.get("socket_path"):
        return _check(
            "app.identity", "skip",
            "app or control socket unavailable; runtime identity was not checked.",
        )
    try:
        response = socket_send({"action": "query-state"}, session=session, timeout=2.0)
    except (OSError, ValueError, KeyError, TypeError, SystemExit) as err:
        return _check(
            "app.identity", "skip",
            f"query-state unavailable; runtime identity was not checked "
            f"({type(err).__name__}).",
        )

    identity = identity_from_query_state(response)
    source_state = identity["source_state"]
    if source_state == "matches":
        status = "ok"
    elif source_state == "differs":
        status = "warn"
    else:
        status = "skip"

    return _check(
        "app.identity", status, describe_identity(identity),
        identity=identity,
        source_state=source_state,
        binary_state=identity["binary_state"],
    )


def _socket_path(session: str | None) -> str:
    override = os.environ.get("TAAROF_SOCK")
    if override:
        return override
    data = _registry_data(session)
    path = data.get("socket_path")
    if not path:
        raise SystemExit(f"registry {_registry_path(session)} missing socket_path")
    return path


def _http_base() -> str:
    return os.environ.get("TAAROF_HTTP", "http://127.0.0.1:7800")


def _http_token(session: str | None) -> str | None:
    override = os.environ.get("TAAROF_HTTP_TOKEN")
    if override:
        return override

    data = _registry_data(session)
    pid = data.get("pid")
    if not isinstance(pid, int):
        return None

    token_path = _runtime_dir() / f"taarof-http-{pid}.token"
    try:
        token = token_path.read_text(encoding="utf-8").strip()
    except OSError:
        return None
    return token or None


def http_get(path: str, session: str | None = None) -> Any:
    url = _http_base().rstrip("/") + path
    headers = {}
    if path != "/health":
        token = _http_token(session)
        if token:
            headers["Authorization"] = f"Bearer {token}"
    request = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(request, timeout=5) as resp:  # noqa: S310
        return json.loads(resp.read().decode())


def socket_send(payload: dict[str, Any], session: str | None = None,
                timeout: float = 10.0) -> dict[str, Any]:
    path = _socket_path(session)
    line = (json.dumps(payload, separators=(",", ":")) + "\n").encode()
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(timeout)
        sock.connect(path)
        sock.sendall(line)
        # Half-close write side so server returns response and closes.
        try:
            sock.shutdown(socket.SHUT_WR)
        except OSError:
            pass
        chunks: list[bytes] = []
        while True:
            buf = sock.recv(65536)
            if not buf:
                break
            chunks.append(buf)
    raw = b"".join(chunks).decode().strip()
    if not raw:
        raise SystemExit("no response from taarof socket")
    # Server returns one JSON object. Tolerate trailing newline.
    return json.loads(raw.splitlines()[-1])


def _emit(obj: Any, pretty: bool) -> None:
    if pretty:
        print(json.dumps(obj, indent=2, sort_keys=True))
    else:
        print(json.dumps(obj, separators=(",", ":")))


# ---------------------------------------------------------------------------
# Human / table rendering
# ---------------------------------------------------------------------------
#
# `_emit` handles machine (JSON) output. The renderers below turn a small set
# of read-command payloads into stable, jq-free plain-text tables or concise
# summaries. Each renderer takes the decoded response object and returns a
# string (already terminated as needed) OR None to fall back to JSON.
#
# A command opts into human rendering by setting `_render=<name>` on its
# subparser defaults; `RENDERERS` maps that name to a function. Rendering only
# happens when the effective format is "table" (see `_resolve_format`).


def _stdout_is_tty() -> bool:
    try:
        return sys.stdout.isatty()
    except (AttributeError, ValueError):
        return False


def _resolve_format(fmt: str | None) -> str:
    """Resolve a --format value to a concrete 'json' or 'table'."""
    if fmt == "auto":
        return "table" if _stdout_is_tty() else "json"
    if fmt in ("json", "table"):
        return fmt
    return "json"


def _unwrap_data(obj: Any) -> Any:
    """Return the payload for socket/HTTP responses that wrap under `data`."""
    if isinstance(obj, dict) and "data" in obj and set(obj.keys()) <= {"ok", "data"}:
        return obj.get("data")
    return obj


def _render_table(headers: list[str], rows: list[list[str]]) -> str:
    """Render aligned plain-text columns. Stdlib only, stable order."""
    cols = [str(h) for h in headers]
    body = [[("" if c is None else str(c)) for c in row] for row in rows]
    widths = [len(h) for h in cols]
    for row in body:
        for i, cell in enumerate(row):
            if len(cell) > widths[i]:
                widths[i] = len(cell)
    lines = []
    header_line = "  ".join(cols[i].ljust(widths[i]) for i in range(len(cols)))
    lines.append(header_line.rstrip())
    lines.append("  ".join("-" * widths[i] for i in range(len(cols))))
    for row in body:
        lines.append("  ".join(row[i].ljust(widths[i]) for i in range(len(cols))).rstrip())
    return "\n".join(lines)


def _tab_agent_summary(tab: dict[str, Any]) -> str:
    """Best-effort agent label from a tab's `agents` array or `agent_name`."""
    names: list[str] = []
    for agent in tab.get("agents") or []:
        if isinstance(agent, dict):
            name = agent.get("agent_name")
            if name:
                names.append(str(name))
    if not names and tab.get("agent_name"):
        names.append(str(tab["agent_name"]))
    # De-duplicate preserving order.
    seen: set[str] = set()
    unique = [n for n in names if not (n in seen or seen.add(n))]
    return ", ".join(unique)


def _iter_tabs(payload: dict[str, Any]) -> list[tuple[dict[str, Any], dict[str, Any]]]:
    """Yield (workspace, tab) pairs from a list-tabs / query-state payload."""
    out: list[tuple[dict[str, Any], dict[str, Any]]] = []
    for ws in payload.get("workspaces") or []:
        if not isinstance(ws, dict):
            continue
        for tab in ws.get("tabs") or []:
            if isinstance(tab, dict):
                out.append((ws, tab))
    return out


def render_list_tabs(obj: Any) -> str | None:
    data = _unwrap_data(obj)
    if not isinstance(data, dict):
        return None
    pairs = _iter_tabs(data)
    if not pairs:
        return "no tabs"
    rows = []
    for ws, tab in pairs:
        rows.append([
            tab.get("tab_id"),
            tab.get("name") or "",
            ws.get("name") or "",
            _tab_agent_summary(tab),
            "!" if tab.get("needs_attention") else "",
        ])
    return _render_table(["id", "name", "workspace", "agents", "attn"], rows)


def render_query_state(obj: Any) -> str | None:
    data = _unwrap_data(obj)
    if not isinstance(data, dict):
        return None
    workspaces = data.get("workspaces") or []
    pairs = _iter_tabs(data)
    lines = []
    session = data.get("session_name")
    lines.append("session:    {}".format(session if session else "(unnamed)"))
    lines.append("workspaces: {}".format(len(workspaces)))
    lines.append("tabs:       {}".format(len(pairs)))
    runtime_probe = data.get("runtime_probe")
    if isinstance(runtime_probe, dict):
        probe_state = runtime_probe.get("state") or "unknown"
        component_text = []
        for name in ("process", "ports"):
            component = runtime_probe.get(name)
            if not isinstance(component, dict):
                continue
            state = component.get("state") or "unknown"
            age_ms = component.get("age_ms")
            age = f" ({age_ms}ms)" if isinstance(age_ms, int) and not isinstance(age_ms, bool) else ""
            component_text.append(f"{name}={state}{age}")
        suffix = f" — {', '.join(component_text)}" if component_text else ""
        lines.append(f"runtime probe: {probe_state}{suffix}")
    lines.append("")
    if not pairs:
        lines.append("no tabs")
        return "\n".join(lines)
    rows = []
    for ws, tab in pairs:
        rows.append([
            tab.get("tab_id"),
            tab.get("name") or "",
            ws.get("name") or "",
            _tab_agent_summary(tab),
            "!" if tab.get("needs_attention") else "",
        ])
    lines.append(_render_table(["id", "name", "workspace", "agents", "attn"], rows))
    return "\n".join(lines)


def render_query_history(obj: Any) -> str | None:
    data = _unwrap_data(obj)
    if not isinstance(data, dict) or not isinstance(data.get("records"), list):
        return None
    rows = []
    for record in data["records"]:
        if not isinstance(record, dict):
            continue
        rows.append([
            record.get("id"),
            record.get("ts_unix_ms"),
            record.get("record_type") or "",
            record.get("subtype") or "",
            record.get("session") or "",
            record.get("task_id") or "",
            record.get("summary") or "",
        ])
    if not rows:
        return "no history records"
    return _render_table(
        ["id", "timestamp_ms", "type", "subtype", "session", "task", "summary"], rows)


def _agent_rows_from_state(payload: dict[str, Any]) -> list[list[Any]]:
    """One row per live agent from a query-state payload.

    Prefer each pane's `agents[]` array (fields: agent_name, pane_id,
    session_id, activity{state,text}). When a tab has no `agents` key at all
    (older app), fall back to the tab-level agent_name / agent_pane_id /
    agent_session_id / agent_activity fields.
    """
    rows: list[list[Any]] = []
    for ws, tab in _iter_tabs(payload):
        ws_name = ws.get("name") or ""
        tab_name = tab.get("name") or ""
        agents = tab.get("agents")
        if isinstance(agents, list) and agents:
            for agent in agents:
                if not isinstance(agent, dict):
                    continue
                activity = agent.get("activity") or {}
                if not isinstance(activity, dict):
                    activity = {}
                rows.append([
                    agent.get("agent_name") or "",
                    ws_name,
                    tab_name,
                    agent.get("pane_id"),
                    agent.get("session_id") or "",
                    activity.get("state") or "",
                    activity.get("text") or "",
                ])
        elif tab.get("agent_name"):
            # Fallback path: no per-pane agents[] (older app).
            activity = tab.get("agent_activity") or {}
            if not isinstance(activity, dict):
                activity = {}
            rows.append([
                tab.get("agent_name") or "",
                ws_name,
                tab_name,
                tab.get("agent_pane_id"),
                tab.get("agent_session_id") or "",
                activity.get("state") or "",
                activity.get("text") or "",
            ])
    return rows


def render_agent_ls(obj: Any) -> str | None:
    data = _unwrap_data(obj)
    if not isinstance(data, dict):
        return None
    rows = _agent_rows_from_state(data)
    if not rows:
        return "no live agents"
    return _render_table(
        ["agent", "workspace", "tab", "pane", "session_id", "state", "activity"],
        rows)


def render_detached(obj: Any) -> str | None:
    data = _unwrap_data(obj)
    if not isinstance(data, list):
        return None
    if not data:
        return "no detached sessions"
    rows = []
    for s in data:
        if not isinstance(s, dict):
            continue
        rows.append([
            s.get("session_name") or "",
            s.get("host") or "",
            s.get("workspace") or "",
            "finished" if s.get("finished") else "running",
            s.get("last_command") or "",
        ])
    return _render_table(["session", "host", "workspace", "state", "last_command"], rows)


def render_dashboard_state(obj: Any) -> str | None:
    data = _unwrap_data(obj)
    if not isinstance(data, dict):
        return None
    sessions = data.get("sessions") or []
    hosts = data.get("hosts") or []
    lines = []
    if hosts:
        rows = []
        for h in hosts:
            if not isinstance(h, dict):
                continue
            rows.append([
                h.get("name") or "",
                h.get("cpu_percent"),
                h.get("memory_percent"),
                h.get("session_count"),
            ])
        lines.append("hosts:")
        lines.append(_render_table(["name", "cpu%", "mem%", "sessions"], rows))
    else:
        lines.append("no hosts")
    lines.append("")
    if sessions:
        rows = []
        for s in sessions:
            if not isinstance(s, dict):
                continue
            rows.append([
                s.get("name") or "",
                s.get("host") or "",
                s.get("status") or "",
                s.get("command") or "",
            ])
        lines.append("sessions:")
        lines.append(_render_table(["name", "host", "status", "command"], rows))
    else:
        lines.append("no sessions")
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# tmux inventory + selector resolution
# ---------------------------------------------------------------------------
#
# `taarof tmux ls` and `taarof tmux attach <selector...>` share one merged view
# of tmux sessions. `build_tmux_inventory` folds three read-only sources into a
# de-duplicated list of rows, and `resolve_tmux_selector` maps friendly
# selectors onto a single (session_name, host) identity. Both are pure functions
# over plain dicts so tests drive them without a socket.
#
# Row schema (all keys always present; unknown values are None/""):
#   session      generated tmux session name (identity part 1)
#   host         host display label ("" == local) (identity part 2)
#   ssh_target   explicit ssh target for the host, when known (attach forwards it)
#   workspace    owning workspace name (attached rows only)
#   tab          owning tab name (attached rows only)
#   tab_id       owning tab id (attached rows only; switch-tab target)
#   pane         pane id within the tab (attached rows only)
#   state        "attached" | "detached"
#   command      current command, when known
#   cwd          working directory, when known
#   updated_ms   best available unix-ms timestamp for age (None when unknown)


TMUX_LS_COLUMNS = ["host", "workspace", "tab", "pane", "session", "state",
                   "command", "cwd", "age"]


def _tmux_host_label(value: Any) -> str:
    """Normalise a host value to a canonical identity label.

    None/'' and the common local spellings ("localhost", "127.0.0.1", "::1",
    "local") all mean THIS machine and collapse to '' — query-state reports
    local panes with tmux_host null while dashboard-state labels the same
    session "localhost", and both must de-duplicate to one identity. Genuinely
    remote hosts pass through unchanged and stay distinct.
    """
    if value is None:
        return ""
    text = str(value).strip()
    if text.lower() in ("localhost", "127.0.0.1", "::1", "local"):
        return ""
    return text


def _blank_row(session: str, host: str) -> dict[str, Any]:
    return {
        "session": session,
        "host": host,
        "ssh_target": None,
        "workspace": None,
        "tab": None,
        "tab_id": None,
        "pane": None,
        "state": None,
        "command": None,
        "cwd": None,
        "updated_ms": None,
    }


def _fill_missing(row: dict[str, Any], key: str, value: Any) -> None:
    """Set row[key] only when it carries a real value and the slot is empty."""
    if value in (None, ""):
        return
    if row.get(key) in (None, ""):
        row[key] = value


def build_tmux_inventory(
    state: Any,
    detached: Any,
    dashboard: Any,
) -> list[dict[str, Any]]:
    """Merge attached (query-state), detached (list-detached), and dashboard
    sessions into one de-duplicated list keyed by (session_name, host).

    Each argument may be a raw response envelope (``{"ok", "data"}``) or the
    already-unwrapped payload; ``_unwrap_data`` handles both. Any argument may be
    None/empty. Attached rows are authoritative for workspace/tab/pane context;
    detached/dashboard rows fill in gaps and contribute detached identities.
    """
    rows: dict[tuple[str, str], dict[str, Any]] = {}

    def row_for(session: Any, host: Any) -> dict[str, Any] | None:
        if session in (None, ""):
            return None
        session = str(session)
        host = _tmux_host_label(host)
        key = (session, host)
        row = rows.get(key)
        if row is None:
            row = _blank_row(session, host)
            rows[key] = row
        return row

    # (1) attached sessions from query-state panes.
    state_data = _unwrap_data(state) if state is not None else None
    if isinstance(state_data, dict):
        for ws in state_data.get("workspaces") or []:
            if not isinstance(ws, dict):
                continue
            ws_name = ws.get("name") or ""
            for tab in ws.get("tabs") or []:
                if not isinstance(tab, dict):
                    continue
                tab_name = tab.get("name") or ""
                for pane in tab.get("panes") or []:
                    if not isinstance(pane, dict):
                        continue
                    session = pane.get("tmux_session")
                    if session in (None, ""):
                        continue
                    row = row_for(session, pane.get("tmux_host"))
                    if row is None:
                        continue
                    row["state"] = "attached"
                    _fill_missing(row, "ssh_target", pane.get("tmux_host"))
                    _fill_missing(row, "workspace", ws_name)
                    _fill_missing(row, "tab", tab_name)
                    if row.get("tab_id") is None:
                        row["tab_id"] = tab.get("tab_id")
                    if row.get("pane") in (None, ""):
                        row["pane"] = pane.get("pane_id")
                    probe = pane.get("tmux_probe")
                    probe = probe if isinstance(probe, dict) else {}
                    _fill_missing(row, "command", probe.get("current_command"))
                    _fill_missing(row, "cwd", pane.get("cwd") or probe.get("cwd"))
                    ts = probe.get("checked_at_unix_ms") \
                        or probe.get("observed_at_unix_ms") \
                        or pane.get("location_updated_at_unix_ms") \
                        or pane.get("probe_updated_at_unix_ms")
                    if row.get("updated_ms") is None and isinstance(ts, (int, float)):
                        row["updated_ms"] = int(ts)

    # (2) detached sessions from list-detached (array payload).
    detached_data = _unwrap_data(detached) if detached is not None else None
    if isinstance(detached_data, list):
        for s in detached_data:
            if not isinstance(s, dict):
                continue
            row = row_for(s.get("session_name"), s.get("host"))
            if row is None:
                continue
            if row.get("state") is None:
                row["state"] = "detached"
            _fill_missing(row, "ssh_target", s.get("ssh_target"))
            _fill_missing(row, "workspace", s.get("workspace"))
            _fill_missing(row, "command", s.get("last_command"))

    # (3) dashboard sessions from dashboard-state ({sessions:[...]}).
    dashboard_data = _unwrap_data(dashboard) if dashboard is not None else None
    if isinstance(dashboard_data, dict):
        for s in dashboard_data.get("sessions") or []:
            if not isinstance(s, dict):
                continue
            row = row_for(s.get("name"), s.get("host"))
            if row is None:
                continue
            if row.get("state") is None:
                status = s.get("status")
                row["state"] = "detached" if s.get("is_detached") else (
                    str(status) if status else "detached")
            _fill_missing(row, "ssh_target", s.get("ssh_target"))
            _fill_missing(row, "command", s.get("command"))
            ts = s.get("started")
            if row.get("updated_ms") is None and isinstance(ts, (int, float)):
                row["updated_ms"] = int(ts)

    # Any row that never got a state (identity from a source lacking one).
    for row in rows.values():
        if row.get("state") is None:
            row["state"] = "detached"

    # Stable order: host, then workspace/tab/session for readable output.
    return sorted(
        rows.values(),
        key=lambda r: (
            r.get("host") or "",
            r.get("workspace") or "",
            r.get("tab") or "",
            r.get("session") or "",
        ),
    )


def _format_age(updated_ms: Any, now_ms: int | None = None) -> str:
    """Human 'age' from an update timestamp; '' when unknown or in the future."""
    if not isinstance(updated_ms, (int, float)):
        return ""
    if now_ms is None:
        import time
        now_ms = int(time.time() * 1000)
    delta = now_ms - int(updated_ms)
    if delta < 0:
        return ""
    secs = delta // 1000
    if secs < 60:
        return f"{secs}s"
    mins = secs // 60
    if mins < 60:
        return f"{mins}m"
    hours = mins // 60
    if hours < 24:
        return f"{hours}h"
    days = hours // 24
    return f"{days}d"


def _tmux_inventory_rows(inventory: list[dict[str, Any]],
                         now_ms: int | None = None) -> list[list[str]]:
    """Render inventory dicts into tmux-ls table rows (order = TMUX_LS_COLUMNS)."""
    out: list[list[str]] = []
    for row in inventory:
        pane = row.get("pane")
        out.append([
            row.get("host") or "",
            row.get("workspace") or "",
            row.get("tab") or "",
            "" if pane in (None, "") else str(pane),
            row.get("session") or "",
            row.get("state") or "",
            row.get("command") or "",
            row.get("cwd") or "",
            _format_age(row.get("updated_ms"), now_ms),
        ])
    return out


def render_tmux_ls(inventory: list[dict[str, Any]],
                   now_ms: int | None = None) -> str:
    """Render a merged tmux inventory as a table. Empty -> 'no tmux sessions'."""
    if not inventory:
        return "no tmux sessions"
    return _render_table(TMUX_LS_COLUMNS, _tmux_inventory_rows(inventory, now_ms))


def resolve_tmux_selector(
    inventory: list[dict[str, Any]],
    *,
    positional: str | None = None,
    workspace: str | None = None,
    tab: str | None = None,
    pane: str | None = None,
    host: str | None = None,
) -> tuple[dict[str, Any] | None, list[dict[str, Any]]]:
    """Resolve a friendly selector against a merged tmux inventory.

    Returns ``(match, candidates)``:
      * exactly one match  -> ``(row, [row])``
      * ambiguous          -> ``(None, [row, row, ...])`` (>1 candidate)
      * no match           -> ``(None, [])``

    Selector forms (checked in this order):
      * bare generated session name (exact ``session`` match), optionally with
        ``--pane`` when combined with ``--tab``;
      * ``--workspace W --tab T`` (names or ids);
      * ``--tab T --pane N``;
      * a single ``positional`` tried as: exact session name -> unique tab-name
        match -> unique ``workspace:tab`` form.

    ``host`` (a display label or ssh target) narrows candidates first, so an
    otherwise-ambiguous bare name can resolve to a single (session, host).
    Identity is always (session_name, host): same name on two hosts stays
    ambiguous unless ``host`` disambiguates.
    """
    host_filter = _tmux_host_label(host) if host not in (None, "") else None

    def host_matches(row: dict[str, Any]) -> bool:
        if host_filter is None:
            return True
        return row.get("host") == host_filter \
            or (row.get("ssh_target") or "") == host_filter

    def norm(value: Any) -> str:
        return "" if value is None else str(value)

    pool = [r for r in inventory if host_matches(r)]

    def finish(cands: list[dict[str, Any]]) -> tuple[dict[str, Any] | None,
                                                     list[dict[str, Any]]]:
        # De-duplicate by identity while preserving order.
        seen: set[tuple[str, str]] = set()
        unique: list[dict[str, Any]] = []
        for row in cands:
            key = (norm(row.get("session")), norm(row.get("host")))
            if key in seen:
                continue
            seen.add(key)
            unique.append(row)
        if len(unique) == 1:
            return unique[0], unique
        return None, unique

    # (a) explicit workspace + tab.
    if workspace is not None and tab is not None:
        cands = [
            r for r in pool
            if norm(r.get("workspace")) == norm(workspace)
            and norm(r.get("tab")) == norm(tab)
        ]
        return finish(cands)

    # (b) tab + pane.
    if tab is not None and pane is not None:
        cands = [
            r for r in pool
            if norm(r.get("tab")) == norm(tab) and norm(r.get("pane")) == norm(pane)
        ]
        return finish(cands)

    # (c) tab alone (name or id).
    if tab is not None and positional is None and workspace is None:
        cands = [r for r in pool if norm(r.get("tab")) == norm(tab)]
        return finish(cands)

    # (d) single positional.
    if positional is not None:
        # exact session name first (fast path).
        exact = [r for r in pool if norm(r.get("session")) == norm(positional)]
        if exact:
            return finish(exact)
        # unique tab-name match.
        by_tab = [r for r in pool if norm(r.get("tab")) == norm(positional)]
        if by_tab:
            return finish(by_tab)
        # "workspace:tab" form.
        if ":" in positional:
            ws_part, _, tab_part = positional.partition(":")
            by_ws_tab = [
                r for r in pool
                if norm(r.get("workspace")) == norm(ws_part)
                and norm(r.get("tab")) == norm(tab_part)
            ]
            if by_ws_tab:
                return finish(by_ws_tab)
        return None, []

    return None, []


def render_workspaces(obj: Any) -> str | None:
    data = _unwrap_data(obj)
    if not isinstance(data, list):
        return None
    if not data:
        return "no workspaces"
    rows = []
    for ws in data:
        if not isinstance(ws, dict):
            continue
        rows.append([
            ws.get("id"),
            ws.get("name") or "",
            ws.get("branch_name") or "",
            ws.get("tab_count"),
            ws.get("run_status") or "",
        ])
    return _render_table(["id", "name", "branch", "tabs", "status"], rows)


def render_tabs(obj: Any) -> str | None:
    """HTTP /tabs projection: a flat array of tab objects."""
    data = _unwrap_data(obj)
    if not isinstance(data, list):
        return None
    if not data:
        return "no tabs"
    rows = []
    for tab in data:
        if not isinstance(tab, dict):
            continue
        rows.append([
            tab.get("tab_id"),
            tab.get("name") or "",
            tab.get("workspace_name") or "",
            _tab_agent_summary(tab),
            "!" if tab.get("needs_attention") else "",
        ])
    return _render_table(["id", "name", "workspace", "agents", "attn"], rows)


def render_panes(obj: Any) -> str | None:
    """HTTP /panes projection: a flat array of pane objects."""
    data = _unwrap_data(obj)
    if not isinstance(data, list):
        return None
    if not data:
        return "no panes"
    rows = []
    for pane in data:
        if not isinstance(pane, dict):
            continue
        rows.append([
            pane.get("tab_id"),
            pane.get("pane_id"),
            pane.get("agent_name") or "",
            pane.get("cwd") or "",
        ])
    return _render_table(["tab", "pane", "agent", "cwd"], rows)


def render_sessions(obj: Any) -> str | None:
    """HTTP /sessions projection: object with detached_sessions + dashboard."""
    data = _unwrap_data(obj)
    if not isinstance(data, dict):
        return None
    lines = []
    session = data.get("session_name")
    lines.append("session:         {}".format(session if session else "(unnamed)"))
    lines.append("active_workspace: {}".format(data.get("active_workspace")))
    lines.append("active_tab:       {}".format(data.get("active_tab")))
    lines.append("")
    detached = data.get("detached_sessions") or []
    if detached:
        rows = []
        for s in detached:
            if not isinstance(s, dict):
                continue
            rows.append([
                s.get("session_name") or "",
                s.get("host") or "",
                s.get("workspace") or "",
                "finished" if s.get("finished") else "running",
            ])
        lines.append("detached sessions:")
        lines.append(_render_table(["session", "host", "workspace", "state"], rows))
    else:
        lines.append("no detached sessions")
    return "\n".join(lines)


def render_agent_sessions(obj: Any) -> str | None:
    """Render a query-agent-sessions snapshot as a table.

    Snapshot shape (from AgentSessionsSnapshot): {schema, generated_at_unix_ms,
    providers:[{name, ok, history_available, session_count, ...}],
    remote_hosts?:[{host, ok, stale, session_count, warning, ...}],
    sessions:[{agent, session_id, title, cwd, status, host?, resume_command?,
    live_binding?{...}, ...}]}.

    Local and remote sessions share one table, so `host` is rendered as its own
    column (blank for local) and `resume` shows the resume command verbatim —
    the remote ones are host-qualified `ssh -t ...` commands, which is the whole
    point of remote discovery. `remote_hosts` is additive and absent when no
    remote host is configured or live.

    If the response does not match this shape, return None so main() falls back
    to JSON rather than crashing.
    """
    data = _unwrap_data(obj)
    if not isinstance(data, dict) or "sessions" not in data:
        return None
    sessions = data.get("sessions")
    if not isinstance(sessions, list):
        return None
    lines: list[str] = []
    providers = data.get("providers")
    if isinstance(providers, list) and providers:
        prows = []
        for prov in providers:
            if not isinstance(prov, dict):
                continue
            prows.append([
                prov.get("name") or "",
                "ok" if prov.get("ok") else "err",
                "yes" if prov.get("history_available") else "no",
                prov.get("session_count"),
            ])
        if prows:
            lines.append("providers:")
            lines.append(_render_table(["provider", "ok", "history", "sessions"], prows))
            lines.append("")
    remote_hosts = data.get("remote_hosts")
    if isinstance(remote_hosts, list) and remote_hosts:
        hrows = []
        for host in remote_hosts:
            if not isinstance(host, dict):
                continue
            hrows.append([
                host.get("host") or "",
                "ok" if host.get("ok") else "err",
                "yes" if host.get("stale") else "no",
                host.get("session_count"),
                host.get("warning") or host.get("error") or "",
            ])
        if hrows:
            lines.append("remote hosts:")
            lines.append(_render_table(
                ["host", "ok", "stale", "sessions", "warning"], hrows))
            lines.append("")
    if not sessions:
        lines.append("no agent sessions")
        return "\n".join(lines)
    rows = []
    for sess in sessions:
        if not isinstance(sess, dict):
            continue
        binding = sess.get("live_binding")
        if isinstance(binding, dict):
            live = binding.get("tab_name") or binding.get("tab_id")
            live = str(live) if live is not None else ""
        else:
            live = ""
        rows.append([
            sess.get("agent") or "",
            sess.get("host") or "",
            sess.get("session_id") or "",
            sess.get("status") or "",
            sess.get("cwd") or "",
            live,
            sess.get("resume_command") or "",
        ])
    lines.append(_render_table(
        ["agent", "host", "session_id", "status", "cwd", "live", "resume"], rows))
    return "\n".join(lines)


