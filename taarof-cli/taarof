_WORK_CONTEXT_ENV = {
    "session": "TAAROF_WORK_SESSION",
    "workspace_origin": "TAAROF_WORK_WORKSPACE_ORIGIN",
    "tab_origin": "TAAROF_WORK_TAB_ORIGIN",
    "pane_origin": "TAAROF_WORK_PANE_ORIGIN",
    "task_id": "TAAROF_WORK_TASK_ID",
    "checkout_root": "TAAROF_WORK_CHECKOUT_ROOT",
    "binding_token": "TAAROF_WORK_BINDING_TOKEN",
}


def _work_context_from_env() -> dict[str, str]:
    context: dict[str, str] = {}
    missing: list[str] = []
    for field, env_name in _WORK_CONTEXT_ENV.items():
        value = os.environ.get(env_name)
        if value:
            context[field] = value
        else:
            missing.append(env_name)
    if missing:
        raise SystemExit(
            "work-report has no complete bound-pane context; missing "
            + ", ".join(missing)
            + ". Stop and do not guess. A dispatched task injects context. For a "
              "manually-bound pane, use this explicit workflow:\n"
              "SESSION='your-named-session'\n"
              "taarof --session \"$SESSION\" panes\n"
              "eval \"$(taarof --session \"$SESSION\" work-context "
              "--tab <numeric-tab-id> --pane <numeric-pane-id> --shell)\""
        )
    return context


def cmd_work_report(args: argparse.Namespace) -> Any:
    context = _work_context_from_env()
    context_session = context["session"]
    if args.session is not None and args.session != context_session:
        raise SystemExit(
            "work-report --session does not match TAAROF_WORK_SESSION; "
            "stop and refresh the bound-pane context"
        )
    msg: dict[str, Any] = {
        "action": "work-report",
        "milestone": args.milestone,
        **context,
    }
    _optional(msg, "note", args.note)
    return socket_send(msg, session=args.session or context_session)


def cmd_work_context(args: argparse.Namespace) -> Any:
    if not args.session:
        raise SystemExit(
            "work-context requires explicit --session before the command; "
            "stop and select the intended taarof session"
        )
    msg: dict[str, Any] = {
        "action": "work-context",
        "tab": str(args.tab),
        "pane": args.pane,
    }
    response = socket_send(msg, session=args.session)
    if not args.shell:
        return response
    if not isinstance(response, dict) or response.get("ok") is False:
        error = response.get("error") if isinstance(response, dict) else None
        print(
            json.dumps({"ok": False, "error": error or "work-context failed"}),
            file=sys.stderr,
        )
        return _SILENT_FAILURE
    data = response.get("data")
    if not isinstance(data, dict):
        print(
            json.dumps({"ok": False, "error": "work-context response is missing data"}),
            file=sys.stderr,
        )
        return _SILENT_FAILURE
    if data.get("session") != args.session:
        print(
            json.dumps({"ok": False, "error": "work-context session mismatch"}),
            file=sys.stderr,
        )
        return _SILENT_FAILURE
    fields = [
        (env_name, data.get(field)) for field, env_name in _WORK_CONTEXT_ENV.items()
    ]
    fields.extend([
        ("TAAROF_WORK_TASK_TITLE", data.get("task_title")),
        ("TAAROF_WORK_INSTRUCTIONS", data.get("instructions")),
    ])
    if any(value in (None, "") for _, value in fields):
        print(
            json.dumps({"ok": False, "error": "work-context response is incomplete"}),
            file=sys.stderr,
        )
        return _SILENT_FAILURE
    for env_name, value in fields:
        print(f"export {env_name}={shlex.quote(str(value))}")
    return None


