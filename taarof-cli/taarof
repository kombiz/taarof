def _toml_escape(value: str) -> str:
    """Escape a string for inclusion as a TOML basic-string value."""
    replacements = {"\\": "\\\\", "\"": "\\\"", "\n": "\\n", "\r": "\\r", "\t": "\\t"}
    out = "".join(replacements.get(c, c) for c in value)
    return f'"{out}"'


def _toml_write_kv(lines: list[str], key: str, value: Any) -> None:
    if value is None:
        return
    if isinstance(value, bool):
        lines.append(f"{key} = {'true' if value else 'false'}")
    elif isinstance(value, (int, float)):
        lines.append(f"{key} = {value}")
    elif isinstance(value, str):
        lines.append(f"{key} = {_toml_escape(value)}")
    elif isinstance(value, list):
        items = ", ".join(_toml_escape(v) if isinstance(v, str) else str(v) for v in value)
        lines.append(f"{key} = [{items}]")
    else:
        raise TypeError(f"unsupported TOML type for {key}: {type(value)}")


def _tab_to_manifest(tab: dict[str, Any]) -> dict[str, Any]:
    """Convert a list-tabs tab entry into a manifest-friendly dict."""
    panes = tab.get("panes") or []
    primary = panes[0] if panes else {}
    tmux_session = primary.get("tmux_session")
    tmux_host = primary.get("tmux_host")
    cwd_host = primary.get("cwd_host")
    cwd = primary.get("cwd")
    out: dict[str, Any] = {"name": tab.get("name") or "tab"}
    if primary.get("remote_shell") and not cwd_host and not tmux_host:
        raise SystemExit(
            f"cannot export remote tab {out['name']!r}: query-state has no "
            "cwd_host or tmux_host SSH target")
    if tab.get("agent_name"):
        out["agent"] = tab["agent_name"]
    # OSC 7 reports cwd_host for local shells too. Only remote_shell establishes
    # that cwd_host is an SSH target; tmux_host is tracked independently.
    if tmux_host:
        out["tmux_host"] = tmux_host
    if primary.get("remote_shell") and cwd_host:
        out["remote"] = cwd_host
    if cwd:
        out["cwd"] = cwd
    if tmux_session:
        out["tmux_session"] = tmux_session
    # Extra panes preserved so export is lossless-ish
    if len(panes) > 1:
        extras = []
        for pane in panes[1:]:
            entry: dict[str, Any] = {"pane_id": pane.get("pane_id")}
            if (pane.get("remote_shell") and not pane.get("cwd_host")
                    and not pane.get("tmux_host")):
                raise SystemExit(
                    f"cannot export remote pane {pane.get('pane_id')!r} in tab "
                    f"{out['name']!r}: query-state has no cwd_host or tmux_host SSH target")
            if pane.get("cwd"):
                entry["cwd"] = pane["cwd"]
            if pane.get("remote_shell") and pane.get("cwd_host"):
                entry["remote"] = pane["cwd_host"]
            if pane.get("tmux_session"):
                entry["tmux_session"] = pane["tmux_session"]
            if pane.get("tmux_host"):
                entry["tmux_host"] = pane["tmux_host"]
            extras.append(entry)
        out["extra_panes"] = extras
    return out


def _render_manifest_toml(state: dict[str, Any]) -> str:
    """Render a list-tabs payload as a TOML workspace manifest."""
    lines: list[str] = [
        "# taarof workspace manifest",
        "# Generated by `taarof workspace export`.",
        "# Apply with `taarof workspace apply FILE --workspace NAME`.",
        "",
    ]
    workspaces = state.get("workspaces") or []
    for ws in workspaces:
        lines.append("[[workspace]]")
        _toml_write_kv(lines, "name", ws.get("name"))
        _toml_write_kv(lines, "repo_root", ws.get("repo_root"))
        _toml_write_kv(lines, "branch", ws.get("branch_name"))
        _toml_write_kv(lines, "is_worktree", ws.get("is_worktree"))
        lines.append("")
        for tab in ws.get("tabs") or []:
            entry = _tab_to_manifest(tab)
            lines.append("[[workspace.tab]]")
            _toml_write_kv(lines, "name", entry.get("name"))
            _toml_write_kv(lines, "agent", entry.get("agent"))
            _toml_write_kv(lines, "remote", entry.get("remote"))
            _toml_write_kv(lines, "tmux_host", entry.get("tmux_host"))
            _toml_write_kv(lines, "tmux_session", entry.get("tmux_session"))
            _toml_write_kv(lines, "cwd", entry.get("cwd"))
            extras = entry.get("extra_panes") or []
            for pane in extras:
                lines.append("")
                lines.append("[[workspace.tab.extra_pane]]")
                for k, v in pane.items():
                    _toml_write_kv(lines, k, v)
            lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def cmd_workspace_export(args: argparse.Namespace) -> Any:
    resp = socket_send({"action": "list-tabs"}, session=args.session)
    if not resp.get("ok"):
        return resp
    data = resp.get("data") or {}
    if args.format == "json":
        payload: Any = data
        if args.workspace:
            payload = {
                "workspaces": [
                    w for w in data.get("workspaces", [])
                    if w.get("name") == args.workspace or str(w.get("id")) == args.workspace
                ]
            }
        if args.out:
            Path(args.out).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
            return {"ok": True, "written": args.out}
        return payload
    # TOML default
    if args.workspace:
        data = {
            "workspaces": [
                w for w in data.get("workspaces", [])
                if w.get("name") == args.workspace or str(w.get("id")) == args.workspace
            ]
        }
    text = _render_manifest_toml(data)
    if args.out:
        Path(args.out).write_text(text)
        return {"ok": True, "written": args.out, "workspaces": len(data.get("workspaces", []))}
    print(text, end="")
    return None  # handled above, suppress json emit


def _ssh_tmux_ensure(host_address: str, session: str, cwd: str | None,
                     *, dry_run: bool) -> dict[str, Any]:
    """Ensure a tmux session exists on `host_address`; create it idempotently."""
    ensure_cmd = f"tmux has-session -t {shlex.quote(session)} 2>/dev/null || " \
        f"tmux new-session -d -s {shlex.quote(session)}"
    if cwd:
        ensure_cmd += f" -c {shlex.quote(cwd)}"
    step: dict[str, Any] = {"host": host_address, "session": session, "cwd": cwd,
                            "command": ensure_cmd}
    if dry_run:
        step["action"] = "would-ensure"
        return step
    proc = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", host_address,
         ensure_cmd],
        capture_output=True, text=True, timeout=20,
    )
    step["action"] = "ensured"
    step["exit_code"] = proc.returncode
    if proc.returncode != 0:
        step["stderr"] = proc.stderr.strip()
    return step


def _local_tmux_ensure(session: str, cwd: str | None,
                       *, dry_run: bool) -> dict[str, Any]:
    step: dict[str, Any] = {"host": "local", "session": session, "cwd": cwd}
    if dry_run:
        step["action"] = "would-ensure"
        return step
    check = subprocess.run(
        ["tmux", "has-session", "-t", session],
        capture_output=True, text=True,
    )
    if check.returncode == 0:
        step["action"] = "already-present"
        step["exit_code"] = 0
        return step
    create = ["tmux", "new-session", "-d", "-s", session]
    if cwd:
        create += ["-c", cwd]
    proc = subprocess.run(create, capture_output=True, text=True)
    step["action"] = "created"
    step["exit_code"] = proc.returncode
    if proc.returncode != 0:
        step["stderr"] = proc.stderr.strip()
    return step


def _resolve_host_alias(alias: str) -> str:
    """Map a host alias from the taarof config to its SSH address."""
    cfg_path = Path.home() / ".config" / "taarof" / "config.toml"
    if not cfg_path.exists() or tomllib is None:
        return alias
    try:
        cfg = tomllib.loads(cfg_path.read_text())
    except (OSError, ValueError):
        return alias
    hosts = cfg.get("hosts") or {}
    entry = hosts.get(alias)
    if isinstance(entry, dict) and isinstance(entry.get("address"), str):
        return entry["address"]
    return alias


def _is_local_hostname(host: Any) -> bool:
    """Return whether an old manifest's remote label names this machine."""
    if not isinstance(host, str):
        return False
    label = host.strip().lower().rstrip(".")
    if not label or "@" in label:
        return False
    local_labels: set[str] = set()
    for resolver in (socket.gethostname, socket.getfqdn):
        try:
            resolved = resolver().strip().lower().rstrip(".")
        except OSError:
            continue
        if resolved:
            local_labels.add(resolved)
            local_labels.add(resolved.split(".", 1)[0])
    return label in local_labels


def _add_tab_warning(tab_report: dict[str, Any], warning: str) -> None:
    previous = tab_report.get("warning")
    tab_report["warning"] = f"{previous}; {warning}" if previous else warning


def cmd_workspace_apply(args: argparse.Namespace) -> Any:
    if tomllib is None:
        raise SystemExit("tomllib not available; need Python 3.11+ to parse manifests")
    manifest = tomllib.loads(Path(args.file).read_text())
    wanted_name = args.workspace
    workspaces = manifest.get("workspace") or []
    if isinstance(workspaces, dict):
        workspaces = [workspaces]
    if wanted_name:
        workspaces = [w for w in workspaces if w.get("name") == wanted_name]
    if not workspaces:
        raise SystemExit(
            f"no workspace matched (--workspace={wanted_name!r} in {args.file})")

    report: dict[str, Any] = {"dry_run": args.dry_run, "workspaces": []}
    for ws in workspaces:
        ws_report: dict[str, Any] = {"name": ws.get("name"), "tabs": [], "tmux": []}
        for tab in ws.get("tab") or []:
            tab_report: dict[str, Any] = {"name": tab.get("name")}
            session = tab.get("tmux_session")
            manifest_remote = tab.get("remote")
            tmux_host = tab.get("tmux_host")
            if _is_local_hostname(manifest_remote):
                if tmux_host:
                    _add_tab_warning(
                        tab_report,
                        "legacy remote field matches the local hostname; using tmux_host "
                        "as the SSH target",
                    )
                else:
                    _add_tab_warning(
                        tab_report,
                        "remote field matches the local hostname; preserving SSH because "
                        "legacy local exports and intentional SSH-to-self are ambiguous",
                    )
            # tmux_host is the recorded connection target. cwd_host/remote may
            # be the server's OSC 7 hostname and need not be an SSH alias.
            remote_alias = tmux_host or manifest_remote
            cwd = tab.get("cwd")
            command: str | None = None

            if session and remote_alias:
                address = _resolve_host_alias(remote_alias)
                if args.ensure_tmux:
                    ws_report["tmux"].append(
                        _ssh_tmux_ensure(address, session, cwd, dry_run=args.dry_run))
                remote_command = f"tmux attach -t {shlex.quote(session)}"
                command = f"ssh -t {shlex.quote(address)} {shlex.quote(remote_command)}"
            elif session:
                if args.ensure_tmux:
                    ws_report["tmux"].append(
                        _local_tmux_ensure(session, cwd, dry_run=args.dry_run))
                command = f"tmux attach -t {shlex.quote(session)}"
            elif remote_alias:
                # Remote host, no tmux — plain SSH (warn: not shareable).
                address = _resolve_host_alias(remote_alias)
                base = f"ssh -t {shlex.quote(address)}"
                if cwd:
                    remote_command = f"cd {shlex.quote(cwd)} && exec $SHELL -l"
                    base += f" {shlex.quote(remote_command)}"
                command = base
                _add_tab_warning(
                    tab_report, "remote tab without tmux_session is not shareable")
            # else: purely local shell, no command (taarof opens default shell)

            payload: dict[str, Any] = {"action": "create-tab"}
            if tab.get("name"):
                payload["name"] = tab["name"]
            if cwd and not remote_alias and not session:
                payload["working_dir"] = cwd
            if command:
                payload["command"] = command

            tab_report["payload"] = payload
            if args.dry_run:
                tab_report["action"] = "would-create"
            else:
                resp = socket_send(payload, session=args.session)
                tab_report["action"] = "created"
                tab_report["response"] = resp
                if not resp.get("ok"):
                    ws_report["tabs"].append(tab_report)
                    ws_report["error"] = f"failed on tab {tab.get('name')!r}"
                    report["workspaces"].append(ws_report)
                    if args.fail_fast:
                        return {"ok": False, "error": ws_report["error"], "report": report}
                    continue
            ws_report["tabs"].append(tab_report)
        report["workspaces"].append(ws_report)
    report["ok"] = True
    return report


def cmd_raw(args: argparse.Namespace) -> Any:
    payload = json.loads(args.json)
    if not isinstance(payload, dict):
        raise SystemExit("raw payload must be a JSON object")
    return socket_send(payload, session=args.session)


def cmd_socket_path(args: argparse.Namespace) -> Any:
    return {"socket_path": _socket_path(args.session)}


# ---------------------------------------------------------------------------
# Config: path / default / validate
# ---------------------------------------------------------------------------
#
# Real TOML validation and default generation live in the taarof-app binary
# (the actual parser) — never re-implemented here — so the two never drift.
# These commands shell out to it and fall back gracefully when it is absent.

_CONVENTIONAL_CONFIG_PATH = Path.home() / ".config" / "taarof" / "config.toml"
_CONVENTIONAL_KEYBINDINGS_PATH = Path.home() / ".config" / "taarof" / "keybindings.toml"

# Minimal static starter used only when the binary is unavailable. The binary's
# `config-default` is authoritative; this is a clearly-labelled fallback.
_FALLBACK_DEFAULT_CONFIG = """\
# taarof configuration (~/.config/taarof/config.toml)
#
# WARNING: taarof-app binary not found — this is a minimal fallback template,
# not the authoritative default. Run `taarof config default` again once the app
# is installed to get the full commented config.

# [sidebar]
# position = "left"

# [tmux]
# enabled = false
# close_behavior = "close"   # "close" or "detach"

# [http]
# enabled = false
# port = 7800
"""


def _find_app_binary() -> str | None:
    """Locate the taarof-app binary.

    Discovery order:
      1. $TAAROF_APP_BIN (explicit override)
      2. the running app's executable via /proc/<pid>/exe (registry pid)
      3. `taarof-app` on PATH
    Returns an absolute path / command name, or None if nothing is found.
    """
    import shutil

    override = os.environ.get("TAAROF_APP_BIN")
    if override:
        return override

    # Best-effort: the executable backing the currently running app.
    try:
        data = _registry_data(None)
    except SystemExit:
        data = None
    if isinstance(data, dict):
        pid = data.get("pid")
        if isinstance(pid, int):
            exe = _pid_exe(pid)
            if exe and Path(exe).exists():
                return exe

    return shutil.which("taarof-app")


def _run_app_binary(app_bin: str, args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [app_bin, *args], capture_output=True, text=True, timeout=15
    )


def cmd_config_path(args: argparse.Namespace) -> Any:
    app_bin = _find_app_binary()
    if app_bin:
        extra = ["--json"] if args.format == "json" else []
        try:
            proc = _run_app_binary(app_bin, ["config-paths", *extra])
        except (OSError, subprocess.TimeoutExpired) as err:
            print(f"# taarof-app config-paths failed ({err}); using conventional paths",
                  file=sys.stderr)
        else:
            if proc.returncode == 0:
                sys.stdout.write(proc.stdout)
                raise SystemExit(0)
            print(proc.stderr, file=sys.stderr, end="")
            raise SystemExit(proc.returncode)

    # Fallback: print conventional paths with a note.
    if args.format == "json":
        _emit(
            {
                "config": str(_CONVENTIONAL_CONFIG_PATH),
                "keybindings": str(_CONVENTIONAL_KEYBINDINGS_PATH),
                "note": "taarof-app not found; conventional paths",
            },
            args.pretty,
        )
    else:
        print(f"config: {_CONVENTIONAL_CONFIG_PATH}")
        print(f"keybindings: {_CONVENTIONAL_KEYBINDINGS_PATH}")
        print("# note: taarof-app not found; showing conventional paths", file=sys.stderr)
    raise SystemExit(0)


def cmd_config_default(args: argparse.Namespace) -> Any:
    app_bin = _find_app_binary()
    text: str
    if app_bin:
        try:
            proc = _run_app_binary(app_bin, ["config-default"])
        except (OSError, subprocess.TimeoutExpired) as err:
            print(f"# taarof-app config-default failed ({err}); using fallback template",
                  file=sys.stderr)
            text = _FALLBACK_DEFAULT_CONFIG
        else:
            if proc.returncode == 0:
                text = proc.stdout
            else:
                print(proc.stderr, file=sys.stderr, end="")
                raise SystemExit(proc.returncode)
    else:
        print("# note: taarof-app not found; using fallback template", file=sys.stderr)
        text = _FALLBACK_DEFAULT_CONFIG

    if not args.write:
        sys.stdout.write(text)
        raise SystemExit(0)

    dest = _CONVENTIONAL_CONFIG_PATH
    if dest.exists() and not args.force:
        raise SystemExit(
            f"refusing to overwrite existing {dest} (pass --force to overwrite)"
        )
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(text, encoding="utf-8")
    print(f"wrote {dest}")
    raise SystemExit(0)


def cmd_config_validate(args: argparse.Namespace) -> Any:
    app_bin = _find_app_binary()
    if not app_bin:
        raise SystemExit(
            "taarof-app not found; cannot validate config. "
            "Set TAAROF_APP_BIN or install taarof-app."
        )

    extra: list[str] = []
    # Default to the binary's human table output; opt into JSON with --format json
    # (or --format auto on a non-TTY, matching the rest of the CLI).
    fmt = args.format or "table"
    if _resolve_format(fmt) == "json":
        extra.append("--json")
    if args.config:
        extra += ["--config", args.config]
    if args.keybindings:
        extra += ["--keybindings", args.keybindings]

    try:
        proc = _run_app_binary(app_bin, ["config-validate", *extra])
    except (OSError, subprocess.TimeoutExpired) as err:
        raise SystemExit(f"taarof-app config-validate failed: {err}")

    sys.stdout.write(proc.stdout)
    if proc.stderr:
        sys.stderr.write(proc.stderr)
    raise SystemExit(proc.returncode)


