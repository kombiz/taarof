def _gather_tmux_inventory(session: str | None) -> list[dict[str, Any]]:
    """Query the three read-only sources and merge them into one inventory.

    dashboard-state is best-effort: some builds may not populate it, so a failed
    query degrades gracefully to the attached + detached view.
    """
    state = socket_send({"action": "query-state"}, session=session)
    detached = socket_send({"action": "list-detached"}, session=session)
    try:
        dashboard: Any = socket_send({"action": "dashboard-state"}, session=session)
    except (SystemExit, OSError, ValueError):
        dashboard = None
    return build_tmux_inventory(state, detached, dashboard)


