    return None


def cmd_tmux_attach(args: argparse.Namespace) -> Any:
    """Resolve a friendly selector to a (session, host), then act on its state.

    * resolved row is ATTACHED (live tab in this taarof instance): "attach"
      means focus it — send switch-tab to its tab id. The app-side
      attach-session only accepts sessions from the detached list, so
      attach-session would fail here anyway.
    * resolved row is DETACHED: send attach-session (host/ssh_target forwarded).

    The returned JSON carries a `sent` key echoing the payload actually sent so
    callers can see which path ran.

    Bare-session fast path: when only a positional is given and it exactly names
    a session with no ambiguity, resolution collapses to that row directly; an
    unknown lone name still attaches literally (the app may know sessions the
    read surfaces do not). Any ambiguity prints a candidates table and exits 1
    without attaching.
    """
    inventory = _gather_tmux_inventory(args.session)
    match, candidates = resolve_tmux_selector(
        inventory,
        positional=args.selector,
        workspace=args.workspace,
        tab=args.tab,
        pane=args.pane,
        host=args.host,
    )

    # Bare-session fast path / back-compat: a lone positional session name that
    # the inventory does not know about is still attached literally (the app may
    # know a session the read surfaces do not, and this preserves the historical
    # `tmux attach <name>` behaviour). Only genuine ambiguity blocks.
    bare_name = (
        args.selector is not None
        and args.workspace is None
        and args.tab is None
        and args.pane is None
    )
    if match is None and bare_name and not candidates:
        msg: dict[str, Any] = {
            "action": "attach-session", "session_name": args.selector}
        _optional(msg, "host", args.host)
        _optional(msg, "ssh_target", args.ssh_target)
        return _send_with_echo(msg, args.session)

    if match is None:
        described = _describe_tmux_selector(args)
        if not candidates:
            print(f"no tmux session matches {described}", file=sys.stderr)
            raise SystemExit(1)
        print(f"ambiguous tmux selector {described}: {len(candidates)} candidates",
              file=sys.stderr)
        print(render_tmux_ls(candidates), file=sys.stderr)
        print("hint: narrow with --host, --workspace/--tab, or an exact session name.",
              file=sys.stderr)
        raise SystemExit(1)

    # Already attached -> focus its live tab. attach-session is detached-only
    # app-side ("Session not found in detached list"), and focusing is what
    # "attach" means for a session that is already open here.
    if match.get("state") == "attached":
        tab_target = match.get("tab_id")
        if tab_target in (None, ""):
            tab_target = match.get("tab")
        if tab_target not in (None, ""):
            # The socket protocol takes the tab target as a string (id or name).
            msg = {"action": "switch-tab", "tab": str(tab_target)}
            return _send_with_echo(msg, args.session)
        # Attached but no tab known (shouldn't happen) — fall through.

    msg = {"action": "attach-session", "session_name": match["session"]}
    # Forward host/ssh_target: an explicit flag wins, else use resolved values.
    host = args.host or (match.get("host") or None)
    ssh_target = args.ssh_target or match.get("ssh_target")
    _optional(msg, "host", host)
    _optional(msg, "ssh_target", ssh_target)
    return _send_with_echo(msg, args.session)


def _send_with_echo(msg: dict[str, Any], session: str | None) -> Any:
    """Send a socket payload; echo it back as `sent` in the response dict so the
    caller can see which action ran (switch-tab vs attach-session)."""
    resp = socket_send(msg, session=session)
    if isinstance(resp, dict):
        return {**resp, "sent": msg}
    return resp


def _describe_tmux_selector(args: argparse.Namespace) -> str:
    """Human description of the selector args for error messages."""
    parts: list[str] = []
    if args.selector is not None:
        parts.append(repr(args.selector))
    if args.workspace is not None:
        parts.append(f"--workspace {args.workspace!r}")
    if args.tab is not None:
        parts.append(f"--tab {args.tab!r}")
    if args.pane is not None:
        parts.append(f"--pane {args.pane!r}")
    if args.host is not None:
        parts.append(f"--host {args.host!r}")
    return " ".join(parts) if parts else "(no selector given)"


