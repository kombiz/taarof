def build_parser() -> argparse.ArgumentParser:
    # `common_base` holds the args every command shares. `common` adds the
    # read-command --format flag on top. The workspace subgroup uses
    # `common_base` only, because `workspace export` has its own unrelated
    # --format {toml,json}. (Parents share action objects by reference, so we
    # must not let a resolve-conflict mutate a --format action shared with the
    # top-level parser.)
    common_base = argparse.ArgumentParser(add_help=False)
    # Keep a value supplied before the subcommand from being overwritten by
    # the inherited subparser action's absent default.
    common_base.add_argument(
        "--session", default=argparse.SUPPRESS,
        help="Named taarof session (defaults to unnamed).",
    )
    common_base.add_argument("--pretty", action="store_true", help="Indent JSON output.")

    common = argparse.ArgumentParser(add_help=False, parents=[common_base])
    common.add_argument(
        "--format", choices=["json", "table", "auto"], default=None,
        help="Output format for read commands. json (default for flat commands, "
        "byte-compatible with older output), table (human columns), or auto "
        "(table on a TTY, json otherwise). Grouped commands default to auto.",
    )

    p = argparse.ArgumentParser(prog="taarof", parents=[common],
                                description="Control the running taarof app.")
    # Documented here for `--help`, but handled before parsing (see `main`)
    # because the subcommand is required and `--version` legitimately has none.
    p.add_argument(
        "--version", "-V", action="store_true",
        help="Report CLI, app and source-build identity, then exit.")
    sub = p.add_subparsers(dest="cmd", required=True, parser_class=lambda **kw:
                           argparse.ArgumentParser(parents=[common], **kw))

    # Read-only HTTP
    sub.add_parser("health").set_defaults(func=cmd_health)
    for route in ("runtime-identity", "state", "sessions", "workspaces", "tabs", "panes"):
        s = sub.add_parser(route, help=f"GET /api/v1/{route}")
        s.set_defaults(func=cmd_http_get, _route=route, _render=route)
    s = sub.add_parser("events", help="GET /api/v1/events (HTTP)")
    s.add_argument("--since", type=int, help="since_seq filter")
    s.set_defaults(func=cmd_events)

    # Socket reads
    _cfg_list_tabs(sub.add_parser("list-tabs"))
    sub.add_parser("query-state").set_defaults(func=cmd_query_state, _render="query-state")
    sub.add_parser(
        "version",
        help="Report CLI, app and source-build identity (same data as --version).",
    ).set_defaults(func=cmd_version, _render="version", _format_default="auto")
    s = sub.add_parser("query-events")
    s.add_argument("--since", type=int)
    s.add_argument("--limit", type=int)
    s.set_defaults(func=cmd_query_events)
    s = sub.add_parser("query-history")
    s.add_argument("--since-id", type=int)
    s.add_argument("--limit", type=int)
    s.add_argument("--from-ts", type=int)
    s.add_argument("--to-ts", type=int)
    s.add_argument("--record-type", choices=("event", "diagnostic", "work"))
    s.add_argument("--history-session", dest="session_filter")
    s.add_argument("--workspace")
    s.add_argument("--pane")
    s.add_argument("--task")
    s.add_argument("--repository")
    s.add_argument("--authority")
    s.add_argument("--verification")
    s.set_defaults(func=cmd_query_history, _render="query-history")
    _cfg_get_text(sub.add_parser("get-text"))

    # Pane/tab writes
    _cfg_send_keys(sub.add_parser("send-keys", help="Raw key input (use for Ctrl-C, TUI, etc)."))
    _cfg_run(sub.add_parser("run", help="Shell command + newline (safer than send-keys)."))
    _cfg_open_pane(sub.add_parser("open-pane"))
    _cfg_close_pane(sub.add_parser("close-pane"))
    _cfg_create_tab(sub.add_parser("create-tab"))
    _cfg_close_tab(sub.add_parser("close-tab"))
    _cfg_switch_tab(sub.add_parser("switch-tab"))
    _cfg_rename_tab(sub.add_parser("rename-tab"))
    _cfg_reorder_tab(sub.add_parser(
        "reorder-tab", help="Move a tab to a workspace-relative position (0-based)."))

    # Notifications & agent activity
    s = sub.add_parser("notify")
    s.add_argument("--tab")
    s.add_argument("--message", required=True)
    s.set_defaults(func=cmd_notify)

    _cfg_agent_status(sub.add_parser("agent-status"))
    _cfg_work_report(sub.add_parser(
        "work-report", help="Append an observational milestone for the bound calling pane."))
    _cfg_work_context(sub.add_parser(
        "work-context", help="Bootstrap report context for an explicitly selected bound pane."))
    _cfg_agent_workspace(sub.add_parser(
        "agent-workspace",
        help="Create/reuse a git worktree workspace and optionally run a command."))

    # tmux-backed / detach
    _cfg_create_tmux_tab(sub.add_parser("create-tmux-tab"))
    _cfg_detach_pane(sub.add_parser("detach-pane"))
    _cfg_attach_session(sub.add_parser("attach-session"))

    _cfg_list_detached(sub.add_parser("list-detached"))
    sub.add_parser("dashboard-state").set_defaults(
        func=cmd_dashboard_state, _render="dashboard-state")
    sub.add_parser("open-dashboard").set_defaults(func=cmd_open_dashboard)

    # -----------------------------------------------------------------------
    # Grouped command namespaces.
    #
    # These route to the SAME handlers as the flat commands above (the flat
    # commands remain the compatibility surface). Grouped read commands default
    # to --format auto since they are new and carry no back-compat constraint.
    # -----------------------------------------------------------------------
    def _group(name: str, help_text: str, dest: str):
        gparser = sub.add_parser(name, help=help_text)
        return gparser.add_subparsers(
            dest=dest, required=True,
            parser_class=lambda **kw: argparse.ArgumentParser(parents=[common], **kw))

    # taarof tab ls|create|close|switch|rename|reorder
    tab_sub = _group("tab", "Tab operations (grouped alias of *-tab commands).",
                     "tab_cmd")
    _cfg_list_tabs(tab_sub.add_parser("ls", help="List tabs (alias of list-tabs)."))
    _cfg_create_tab(tab_sub.add_parser("create", help="alias of create-tab"))
    _cfg_close_tab(tab_sub.add_parser("close", help="alias of close-tab"))
    _cfg_switch_tab(tab_sub.add_parser("switch", help="alias of switch-tab"))
    _cfg_rename_tab(tab_sub.add_parser("rename", help="alias of rename-tab"))
    _cfg_reorder_tab(tab_sub.add_parser("reorder", help="alias of reorder-tab"))

    # taarof pane run|open|close|send-keys|get-text|detach
    pane_sub = _group("pane", "Pane operations (grouped alias of pane commands).",
                      "pane_cmd")
    _cfg_run(pane_sub.add_parser("run", help="alias of run"))
    _cfg_open_pane(pane_sub.add_parser("open", help="alias of open-pane"))
    _cfg_close_pane(pane_sub.add_parser("close", help="alias of close-pane"))
    _cfg_send_keys(pane_sub.add_parser("send-keys", help="alias of send-keys"))
    _cfg_get_text(pane_sub.add_parser("get-text", help="alias of get-text"))
    _cfg_detach_pane(pane_sub.add_parser("detach", help="alias of detach-pane"))

    # taarof tmux ls|create-tab|attach|ls-detached
    tmux_sub = _group("tmux", "tmux-backed operations (grouped aliases).", "tmux_cmd")
    _cfg_tmux_ls(tmux_sub.add_parser(
        "ls", help="List all tmux sessions (attached + detached), one table."))
    _cfg_create_tmux_tab(tmux_sub.add_parser("create-tab", help="alias of create-tmux-tab"))
    _cfg_tmux_attach(tmux_sub.add_parser(
        "attach",
        help="Attach a tmux session by friendly selector (session name, tab, "
        "workspace:tab, or --workspace/--tab/--pane)."))
    _cfg_list_detached(tmux_sub.add_parser("ls-detached", help="alias of list-detached"))

    # taarof agent status|workspace
    agent_sub = _group("agent", "Agent activity operations (grouped aliases).",
                       "agent_cmd")
    _cfg_agent_status(agent_sub.add_parser("status", help="alias of agent-status"))
    _cfg_agent_workspace(agent_sub.add_parser("workspace", help="alias of agent-workspace"))
    _cfg_agent_ls(agent_sub.add_parser(
        "ls", help="List live agents (one row per agent) from query-state."))
    _cfg_agent_sessions(agent_sub.add_parser(
        "sessions", help="List discovered agent sessions (query-agent-sessions)."))

    # Config: path / default / validate. Real parsing lives in the taarof-app
    # binary; these shell out (with graceful fallbacks) and never re-implement
    # validation rules in Python.
    config_sub = _group(
        "config", "Inspect, generate, and validate taarof configuration.", "config_cmd")

    cp = config_sub.add_parser("path", help="Print resolved config.toml / keybindings.toml paths.")
    cp.set_defaults(func=cmd_config_path)

    cd = config_sub.add_parser(
        "default", help="Print a commented starter config.toml (or --write it).")
    cd.add_argument("--write", action="store_true",
                    help="Write to the resolved config path instead of stdout.")
    cd.add_argument("--force", action="store_true",
                    help="With --write, overwrite an existing config.toml.")
    cd.set_defaults(func=cmd_config_default)

    cv = config_sub.add_parser("validate", help="Validate config.toml and keybindings.toml.")
    cv.add_argument("--config", help="Path to config.toml (default: resolved path).")
    cv.add_argument("--keybindings", help="Path to keybindings.toml (default: resolved path).")
    cv.set_defaults(func=cmd_config_validate)

    # Grouped read commands default to auto format (TTY -> table, else json).
    for group_sub in (tab_sub, pane_sub, tmux_sub, agent_sub):
        for parser_action in group_sub.choices.values():
            parser_action.set_defaults(_format_default="auto")

    # Workspace manifest. Uses common_base (no read-command --format) because
    # `workspace export` defines its own --format {toml,json}.
    s = sub.add_parser("workspace", help="Workspace manifest export/apply.")
    ws_sub = s.add_subparsers(dest="workspace_cmd", required=True,
                              parser_class=lambda **kw:
                              argparse.ArgumentParser(parents=[common_base], **kw))

    sx = ws_sub.add_parser("export", help="Dump live workspaces as a manifest.")
    sx.add_argument("--workspace", help="Filter to one workspace by name or id.")
    sx.add_argument("--format", choices=["toml", "json"], default="toml")
    sx.add_argument("--out", help="Write to file instead of stdout.")
    sx.set_defaults(func=cmd_workspace_export)

    sa = ws_sub.add_parser("apply", help="Recreate tabs from a workspace manifest.")
    sa.add_argument("file", help="Path to a manifest TOML file.")
    sa.add_argument("--workspace", help="Apply only the workspace with this name.")
    sa.add_argument("--dry-run", action="store_true",
                    help="Print what would happen; make no changes.")
    sa.add_argument("--no-ensure-tmux", dest="ensure_tmux", action="store_false",
                    default=True,
                    help="Skip tmux has-session / new-session bootstrapping.")
    sa.add_argument("--fail-fast", action="store_true",
                    help="Stop on first tab failure.")
    sa.set_defaults(func=cmd_workspace_apply)

    # Workspace lifecycle: create/switch/rename. These drive the workspace-level
    # socket actions (create-workspace / switch-workspace / rename-workspace),
    # mirroring the GUI's New Workspace / switch / rename so behavior stays
    # consistent. --format controls how the response envelope is rendered.
    def _ws_format(sp: argparse.ArgumentParser) -> None:
        sp.add_argument(
            "--format", choices=["json", "table", "auto"], default="auto",
            help="Response output format (default auto).")

    wc = ws_sub.add_parser("create", help="Create a new workspace.")
    wc.add_argument(
        "name", nargs="?",
        help="Workspace name. Omit to auto-name like the GUI (\"Workspace N\").")
    _ws_format(wc)
    wc.set_defaults(func=cmd_workspace_create)

    wsw = ws_sub.add_parser("switch", help="Switch to a workspace by name or id.")
    wsw.add_argument("workspace", help="Workspace name or numeric id.")
    _ws_format(wsw)
    wsw.set_defaults(func=cmd_workspace_switch)

    wr = ws_sub.add_parser("rename", help="Rename a workspace.")
    wr.add_argument("workspace", help="Workspace name or numeric id to rename.")
    wr.add_argument("name", help="New workspace name.")
    _ws_format(wr)
    wr.set_defaults(func=cmd_workspace_rename)

    # Escape hatch
    s = sub.add_parser("raw", help="Send a raw JSON payload to the socket.")
    s.add_argument("json", help="JSON object, e.g. '{\"action\":\"list-tabs\"}'")
    s.set_defaults(func=cmd_raw)

    sub.add_parser("socket-path", help="Print the resolved socket path.").set_defaults(
        func=cmd_socket_path)

    # Diagnostics: non-mutating launch + runtime readiness report.
    sd = sub.add_parser(
        "doctor",
        help="Diagnose local launch and runtime health (non-mutating).")
    sd.add_argument(
        "--probe-hosts", action="store_true",
        help="Actually ssh -o BatchMode=yes each configured host (short timeout). "
        "Off by default so doctor never triggers a remote password prompt.")
    sd.set_defaults(func=cmd_doctor, _render="doctor")

    return p


#: Top-level options that consume the following token, so a `--version` scan
#: can tell an option's value apart from the subcommand name.
_TOP_LEVEL_VALUE_FLAGS = ("--session", "--format")


def _version_requested(argv: list[str]) -> tuple[bool, str | None]:
    """Detect a bare `taarof --version` before argparse demands a subcommand.

    Scans only the pre-subcommand options, so `taarof --session dev --version`
    works while a subcommand's own flags are left entirely to argparse.
    """
    session: str | None = None
    index = 0
    while index < len(argv):
        token = argv[index]
        if token in ("--version", "-V"):
            return True, session
        if token in _TOP_LEVEL_VALUE_FLAGS:
            if token == "--session" and index + 1 < len(argv):
                session = argv[index + 1]
            index += 2
            continue
        if token.startswith("--session="):
            session = token.split("=", 1)[1]
            index += 1
            continue
        if token.startswith("-"):
            index += 1
            continue
        return False, session  # subcommand reached
    return False, session


def main(argv: list[str] | None = None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    wants_version, version_session = _version_requested(raw_argv)
    if wants_version:
        report = build_version_report(version_session)
        _emit(report, "--pretty" in raw_argv)
        return 0

    parser = build_parser()
    args = parser.parse_args(argv)
    if not hasattr(args, "session"):
        args.session = None
    try:
        result = args.func(args)
    except urllib.error.URLError as err:
        print(json.dumps({"ok": False, "error": f"http error: {err}"}), file=sys.stderr)
        return 2
    except (ConnectionError, FileNotFoundError, socket.timeout) as err:
        print(json.dumps({"ok": False, "error": f"socket error: {err}"}), file=sys.stderr)
        return 2
    if result is None:
        return 0
    if result is _SILENT_FAILURE:
        return 1

    # `doctor` reports overall health via `ok`; a False there means "problems
    # found" (exit 1) but we still want to render the full check table, unlike a
    # failed-command envelope which suppresses the human renderer.
    if getattr(args, "_render", None) == "doctor" and isinstance(result, dict):
        fmt = args.format or getattr(args, "_format_default", None) or "auto"
        if _resolve_format(fmt) == "table":
            print(render_doctor(result))
        else:
            _emit(result, args.pretty)
        return 0 if result.get("ok") else 1

    exit_fail = isinstance(result, dict) and result.get("ok") is False

    # Resolve effective format. Flat commands default to json (byte-compatible
    # with older output); grouped commands default to auto via _format_default.
    fmt = args.format or getattr(args, "_format_default", None) or "json"
    effective = _resolve_format(fmt)
    render_name = getattr(args, "_render", None)

    if effective == "table" and render_name and not exit_fail:
        renderer = RENDERERS.get(render_name)
        rendered = renderer(result) if renderer else None
        if rendered is not None:
            print(rendered)
            return 0
        # Renderer declined (unexpected shape); fall through to JSON.

    _emit(result, args.pretty)
    if exit_fail:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
